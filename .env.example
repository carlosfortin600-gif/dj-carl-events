# Port d'écoute (3000 par défaut)
PORT=3000

# Adresse d'écoute (0.0.0.0 pour accepter les connexions externes)
HOST=0.0.0.0

# URL publique du site (obligatoire en ligne pour les liens portail client)
# Exemple : https://events.djcarl.ca
PUBLIC_URL=

# Dossier de la base SQLite (laisser vide = ./data)
DATA_DIR=

# Clé Google Maps (optionnel — temps de route)
GOOGLE_MAPS_API_KEY=

# Notification quand un client modifie son dossier (courriel)
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Alternative recommandée en production (API HTTPS, fonctionne sur Render)
RESEND_API_KEY=
RESEND_FROM=

# Copie des courriels de confirmation client (6 jours avant)
CONFIRMATION_EMAIL_COPY_TO=carlos-fortin@hotmail.com

# Production
NODE_ENV=production
TRUST_PROXY=1
