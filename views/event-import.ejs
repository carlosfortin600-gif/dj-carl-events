<%- include('partials/head', { title }) %>
<%- include('partials/nav', { activeNav }) %>

<main class="container pb-5">
  <div class="row justify-content-center">
    <div class="col-xl-9 col-lg-10">
      <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <a href="/" class="btn btn-outline-secondary btn-sm">← Tableau de bord</a>
        <a href="/events/new" class="btn btn-outline-secondary btn-sm">Saisie manuelle</a>
      </div>

      <h1 class="h3 mb-2">Importer un contrat d'agence</h1>
      <p class="text-muted mb-4">
        Collez le texte du courriel ou du contrat, ou téléversez un PDF.
        L'app propose un dossier prérempli — vous vérifiez avant de créer l'événement.
      </p>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form method="post" action="/events/import" enctype="multipart/form-data" class="card">
        <div class="card-body p-4">
          <div class="mb-4">
            <label class="form-label fw-semibold" for="contract_text">Texte du contrat</label>
            <textarea class="form-control font-monospace small" id="contract_text" name="contract_text" rows="14"
                      placeholder="Collez ici le contenu du contrat (date, noms, salle, adresse, courriel, téléphone…)."></textarea>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold" for="contract_pdf">Ou fichier PDF</label>
            <input type="file" class="form-control" id="contract_pdf" name="contract_pdf" accept="application/pdf,.pdf">
            <p class="form-text mb-0">Si vous ajoutez un PDF et du texte, les deux seront combinés pour l'analyse.</p>
          </div>

          <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary btn-lg">Analyser et continuer</button>
            <a href="/events/new" class="btn btn-outline-secondary btn-lg">Annuler</a>
          </div>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
