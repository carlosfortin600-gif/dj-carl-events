<%- include('partials/head', { title }) %>
<%- include('partials/nav', { activeNav: 'ententes' }) %>

<main class="container pb-5">
  <div class="mb-4">
    <h1 class="h3 mb-1">Ententes</h1>
    <p class="text-muted small mb-0">Statut des contrats par événement — <%= subcontractorLabel %></p>
  </div>

  <nav class="nav nav-pills flex-wrap gap-2 mb-4">
    <% subcontractors.forEach(function(st) { %>
      <a class="nav-link <%= st.id === subcontractorId ? 'active' : '' %>"
         href="/ententes?sousTraitant=<%= st.id %>"><%= st.label %></a>
    <% }); %>
  </nav>

  <div class="card">
    <div class="card-header py-3">
      <h2 class="h6 mb-0">Contrats — <%= subcontractorLabel %></h2>
    </div>
    <div class="card-body">
      <%- include('partials/calendar-ententes-body', {
        agreementsList,
        subcontractorLabel,
        showContractLink: true
      }) %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/contract-print.js"></script>
