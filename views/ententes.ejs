<%- include('partials/head', { title }) %>
<%- include('partials/nav', { activeNav: 'ententes' }) %>

<main class="container-fluid px-3 px-lg-4 pb-5">
  <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-2">
    <div>
      <h1 class="h3 mb-1">Ententes</h1>
      <p class="text-muted small mb-0">Lecture seule — <strong>une ligne par client</strong> (événement). Contrats et ententes regroupés sur la ligne. Ligne <span class="text-danger fw-semibold">rouge</span> si le besoin d’employé est <strong>Non</strong>.</p>
    </div>
    <%- include('partials/export-all-dossiers-btn', {
      exportUpcomingCount: typeof upcomingEventCount !== 'undefined' ? upcomingEventCount : 0,
      exportReturnTo: '/ententes'
    }) %>
  </div>

  <% if (typeof exportEmpty !== 'undefined' && exportEmpty) { %>
    <div class="alert alert-warning">Aucun événement à venir à exporter.</div>
  <% } %>

  <% if (!rowCount) { %>
    <p class="text-muted text-center py-5">Aucune entente à afficher pour les événements à venir.</p>
  <% } else { %>
    <p class="text-muted small mb-3"><%= rowCount %> ligne<%= rowCount !== 1 ? 's' : '' %></p>
    <div class="ententes-by-month">
      <% rowsByMonth.forEach(function(month) { %>
        <section class="upcoming-month-block mb-4<%= month.isCurrentMonth ? ' upcoming-month-block--current' : '' %>">
          <header class="upcoming-month-header">
            <h2 class="upcoming-month-title h5 mb-0"><%= month.heading %></h2>
            <span class="badge upcoming-month-count"><%= month.events.length %> ligne<%= month.events.length !== 1 ? 's' : '' %></span>
          </header>
          <div class="ententes-list">
            <% month.events.forEach(function(row) { %>
              <%- include('partials/ententes-row', { row }) %>
            <% }); %>
          </div>
        </section>
      <% }); %>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
