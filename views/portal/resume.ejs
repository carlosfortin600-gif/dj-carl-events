<%- include('partials/head', { title }) %>

<main class="container pb-5" style="max-width: 920px;">
  <div class="mb-3 d-flex flex-wrap gap-2 align-items-center justify-content-between">
    <a href="/portal/<%= event.portal_token %>/dossier" class="btn btn-outline-secondary btn-sm">← Accueil dossier</a>
    <div class="d-flex flex-wrap gap-2">
      <a href="/portal/<%= event.portal_token %>/plan-soiree" class="btn btn-outline-primary btn-sm">Plan de soirée</a>
      <a href="/portal/<%= event.portal_token %>/musique" class="btn btn-outline-primary btn-sm">Musique</a>
    </div>
  </div>

  <% if (saved) { %>
    <div class="alert alert-success">Merci ! Vos informations ont été enregistrées.</div>
  <% } %>

  <div class="card mb-4">
    <div class="card-body p-4">
      <h1 class="h4 mb-1">Votre dossier</h1>
      <p class="text-muted small mb-0">
        Le <strong>résumé</strong> est fourni par DJ Carl (lecture seule).
        Complétez le <strong>questionnaire</strong> ci-dessous, puis le plan de soirée et la musique.
      </p>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-4">
      <%- include('../partials/portal-resume-summary', {
        event,
        selectedServices,
        customServiceSlots
      }) %>

      <form method="post" action="/portal/<%= event.portal_token %>/resume" id="portalResumeForm" data-unsaved-guard>
        <hr class="my-5">
        <h2 class="h5 mb-4" id="questionnaire"><%= getQuestionnaireLabel(event.event_type) %></h2>

        <% if (isWeddingEvent(event.event_type)) { %>
          <%- include('../partials/questionnaire-form', {
            event,
            questionnaire,
            portalMode: true,
            embedInParentForm: true,
            djLockedFields: typeof djLockedFields !== 'undefined' ? djLockedFields : []
          }) %>
        <% } else { %>
          <%- include('../partials/party-questionnaire-form', {
            event,
            questionnaire,
            portalMode: true,
            embedInParentForm: true,
            djLockedFields: typeof djLockedFields !== 'undefined' ? djLockedFields : []
          }) %>
        <% } %>

        <div class="sticky-save-bar d-flex flex-wrap gap-2 align-items-center justify-content-between mt-4 pt-3 border-top">
          <p class="small text-muted mb-0">Seules vos réponses au questionnaire sont enregistrées.</p>
          <button type="submit" class="btn btn-primary btn-lg">Enregistrer le questionnaire</button>
        </div>
      </form>
    </div>
  </div>
</main>

<script src="/js/portal-questionnaire-lock.js?v=3"></script>
<%- include('partials/footer') %>
