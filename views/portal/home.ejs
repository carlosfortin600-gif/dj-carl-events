<%- include('partials/head', { title }) %>

<main class="container pb-5" style="max-width: 720px;">
  <div class="card portal-welcome mb-4">
    <div class="card-body p-4 text-center">
      <h1 class="h3 mb-2">Bonjour, <%= clientCourtesyName(event) %> !</h1>
      <p class="text-muted mb-0">
        <%= event.event_type %> — <%= formatDateFr(event.event_date) %>
        <% if (event.venue) { %> · <%= event.venue %><% } %>
      </p>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body p-4 text-center">
      <h2 class="h5 mb-2">Votre dossier</h2>
      <p class="text-muted mb-4">
        Résumé de l’événement (lecture seule) et questionnaire à compléter.
        Ensuite : plan de soirée et musique.
      </p>
      <a href="/portal/<%= event.portal_token %>/resume" class="btn btn-primary btn-lg px-4">
        Ouvrir mon dossier
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-4">
      <h2 class="h6 mb-3 text-muted text-uppercase">Étapes complémentaires</h2>

      <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 p-3 rounded portal-task">
        <div>
          <strong>Plan de soirée</strong>
          <div class="small text-muted">Moments, heures et étapes personnalisées</div>
        </div>
        <a href="/portal/<%= event.portal_token %>/plan-soiree" class="btn btn-outline-primary btn-sm">
          Plan de soirée
        </a>
      </div>

      <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 p-3 rounded portal-task mt-3">
        <div>
          <strong>Musique</strong>
          <div class="small text-muted">Décennies, incontournables, styles à éviter…</div>
        </div>
        <a href="/portal/<%= event.portal_token %>/musique" class="btn btn-outline-primary btn-sm">
          Musique
        </a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
