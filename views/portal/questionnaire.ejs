<%- include('partials/head', { title }) %>

<main class="container pb-5">
  <div class="mb-3">
    <a href="/portal/<%= event.portal_token %>" class="btn btn-outline-secondary btn-sm">← Retour</a>
  </div>

  <% if (saved) { %>
    <div class="alert alert-success">Merci ! Vos réponses ont été enregistrées.</div>
  <% } %>

  <div class="card mb-4">
    <div class="card-body p-4">
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
          <h1 class="h4 mb-1"><%= getQuestionnaireLabel(event.event_type) %></h1>
          <p class="text-muted mb-0"><%= clientShortName(event) %> — <%= formatDateFr(event.event_date) %></p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a href="/portal/<%= event.portal_token %>/musique" class="btn btn-outline-primary btn-sm">Musique →</a>
          <a href="/portal/<%= event.portal_token %>/plan-soiree" class="btn btn-outline-primary btn-sm">Plan de soirée →</a>
        </div>
      </div>
      <div class="alert alert-info small mb-0">
        Les réponses déjà remplies sont verrouillées. Complétez les champs encore vides.
        Pour la musique et le plan de soirée, utilisez les onglets dédiés.
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-4">
      <% if (isWeddingEvent(event.event_type)) { %>
        <%- include('../partials/questionnaire-form', {
          event,
          questionnaire,
          proposedTimelineSteps: typeof proposedTimelineSteps !== 'undefined' ? proposedTimelineSteps : [],
          timelineItems: typeof timelineItems !== 'undefined' ? timelineItems : [],
          formAction: '/portal/' + event.portal_token + '/questionnaire',
          portalMode: true,
          djLockedFields: typeof djLockedFields !== 'undefined' ? djLockedFields : []
        }) %>
      <% } else { %>
        <%- include('../partials/party-questionnaire-form', {
          event,
          questionnaire,
          proposedTimelineSteps: typeof proposedTimelineSteps !== 'undefined' ? proposedTimelineSteps : [],
          timelineItems: typeof timelineItems !== 'undefined' ? timelineItems : [],
          formAction: '/portal/' + event.portal_token + '/questionnaire',
          portalMode: true,
          djLockedFields: typeof djLockedFields !== 'undefined' ? djLockedFields : []
        }) %>
      <% } %>
    </div>
  </div>
</main>

<script src="/js/portal-questionnaire-lock.js?v=2"></script>
<%- include('partials/footer') %>
