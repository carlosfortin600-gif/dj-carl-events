<%- include('partials/head', { title }) %>

<main class="container pb-5 portal-avertissement-page" style="max-width: 820px;">
  <div class="card portal-welcome mb-4">
    <div class="card-body p-4 text-center">
      <h1 class="h3 mb-2">Bonjour <%= clientShortName(event) %> !</h1>
      <p class="text-muted mb-0">
        <%= event.event_type %> — <%= formatDateFr(event.event_date) %>
        <% if (event.venue) { %> · <%= event.venue %><% } %>
      </p>
    </div>
  </div>

  <div class="card portal-avertissement-card border-2 border-warning mb-4">
    <div class="card-body p-4 p-md-5 text-center">
      <p class="portal-avertissement-eyebrow text-uppercase fw-semibold text-warning mb-3">Important — à lire avant de continuer</p>
      <h2 class="portal-avertissement-title mb-4">Ce n'est pas un contrat</h2>
      <p class="portal-avertissement-lead mb-4">
        Cet espace client, ce questionnaire et le <strong>plan de soirée</strong>
        <strong>ne constituent pas un contrat</strong>.
      </p>
      <p class="portal-avertissement-body mb-4">
        Il s'agit d'un <strong>plan de soirée</strong> qui reflète l'entente
        conclue avec <strong>l'agence</strong>.
        Le seul document officiel et juridiquement contraignant demeure le
        <strong>contrat de l'agence</strong> que vous avez signé.
      </p>
      <p class="portal-avertissement-body mb-0 fw-semibold">
        <strong>Certains changements</strong> aux informations, à la musique ou au déroulement devront être
        <strong>approuvés par l'agence</strong> avant d'être considérés comme confirmés.
      </p>
    </div>
  </div>

  <form method="post" action="/portal/<%= event.portal_token %>/intro-ack" class="text-center">
    <button type="submit" class="btn btn-primary btn-lg px-5">
      J'ai lu et compris — accéder à mon dossier
    </button>
  </form>
</main>

<%- include('partials/footer') %>
