<%- include('partials/head', { title }) %>

<main class="container pb-5 portal-avertissement-page" style="max-width: 820px;">
  <div class="mb-3">
    <a href="/portal/<%= event.portal_token %>" class="btn btn-outline-secondary btn-sm">← Retour à mon espace</a>
  </div>

  <div class="card portal-avertissement-card border-2 border-warning">
    <div class="card-body p-4 p-md-5 text-center">
      <p class="portal-avertissement-eyebrow text-uppercase fw-semibold text-warning mb-3">Important</p>
      <p class="portal-avertissement-body mb-0 fw-semibold fs-5">
        Certains changements pourraient nécessiter une approbation de l'agence.
      </p>
    </div>
  </div>

  <div class="text-center mt-4">
    <a href="/portal/<%= event.portal_token %>" class="btn btn-primary btn-lg px-4">
      Retour à mon dossier
    </a>
  </div>
</main>

<%- include('partials/footer') %>
