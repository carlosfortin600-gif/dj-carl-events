<%- include('partials/head', { title }) %>

<main class="container pb-5">
  <div class="mb-3">
    <a href="/portal/<%= event.portal_token %>/dossier" class="btn btn-outline-secondary btn-sm">← Retour</a>
  </div>

  <p class="small text-muted mb-3">
    Certains changements pourraient nécessiter une approbation de l'agence.
  </p>
  <% if (saved) { %>
    <div class="alert alert-success">Merci ! Vos préférences musicales ont été enregistrées.</div>
  <% } %>

  <div class="card mb-4">
    <div class="card-body p-4">
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
          <h1 class="h4 mb-1">Musique</h1>
          <p class="text-muted mb-0"><%= clientShortName(event) %> — <%= formatDateFr(event.event_date) %></p>
        </div>
        <a href="/portal/<%= event.portal_token %>/plan-soiree" class="btn btn-outline-primary btn-sm">Plan de soirée →</a>
      </div>
      <p class="text-muted small mb-0">
        Indiquez vos préférences pour la musique de soirée — décennies, chansons incontournables, styles à éviter, etc.
      </p>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-4">
      <%- include('../partials/portal-music-form', {
        event,
        questionnaire,
        formAction: '/portal/' + event.portal_token + '/musique'
      }) %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
