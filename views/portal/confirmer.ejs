<%- include('partials/head', { title }) %>

<main class="container pb-5" style="max-width: 720px;">
  <div class="card portal-welcome mb-4">
    <div class="card-body p-4 text-center">
      <h1 class="h3 mb-2">Confirmer votre dossier</h1>
      <p class="text-muted mb-0">
        <%= event.event_type %> — <%= formatDateFr(event.event_date) %>
      </p>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body p-4">
      <p class="mb-3">
        Avant de confirmer, vérifiez que votre <strong>questionnaire</strong>, votre
        <strong>plan de soirée</strong> et nos échanges reflètent bien ce que vous souhaitez.
      </p>
      <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="/portal/<%= event.portal_token %>" class="btn btn-outline-primary btn-sm">Revoir mon espace client</a>
        <a href="/portal/<%= event.portal_token %>/questionnaire" class="btn btn-outline-secondary btn-sm">Questionnaire</a>
        <a href="/portal/<%= event.portal_token %>/plan-soiree" class="btn btn-outline-secondary btn-sm">Plan de soirée</a>
      </div>

      <div class="alert alert-warning small">
        Après confirmation, votre dossier sera <strong>verrouillé</strong> — vous ne pourrez plus le modifier en ligne.
        Pour tout changement par la suite, contactez DJ Carl.
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger small"><%= error %></div>
      <% } %>

      <form method="post" action="/portal/<%= event.portal_token %>/confirmer"
            onsubmit="return confirm('Confirmer que tout est correct ? Votre dossier sera verrouillé.');">
        <div class="mb-3">
          <label class="form-label" for="confirmed_by_name">Nom de la personne qui confirme</label>
          <input type="text" class="form-control" id="confirmed_by_name" name="confirmed_by_name"
                 value="<%= typeof confirmedByName !== 'undefined' ? confirmedByName : '' %>"
                 placeholder="Ex. Marie Tremblay" required autocomplete="name">
          <div class="form-text">Votre nom complet, tel qu'il apparaîtra sur la confirmation.</div>
        </div>
        <button type="submit" class="btn btn-success btn-lg w-100">
          Tout est correct — je confirme
        </button>
      </form>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
