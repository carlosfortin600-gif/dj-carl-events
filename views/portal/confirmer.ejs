<%- include('partials/head', { title }) %>

<main class="container pb-5" style="max-width: 720px;">
  <div class="card portal-welcome mb-4">
    <div class="card-body p-4 text-center">
      <h1 class="h3 mb-2">Confirmer votre dossier</h1>
      <p class="text-muted mb-0">
        <%= event.event_type %> — <%= formatDateFr(event.event_date) %>
      </p>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body p-4">
      <p class="mb-3">
        Avant de confirmer, vérifiez que votre <strong>questionnaire</strong>, votre
        <strong>plan de soirée</strong> et nos échanges reflètent bien ce que vous souhaitez.
      </p>
      <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="/portal/<%= event.portal_token %>" class="btn btn-outline-primary btn-sm">Revoir mon espace client</a>
        <a href="/portal/<%= event.portal_token %>/questionnaire" class="btn btn-outline-secondary btn-sm">Questionnaire</a>
        <a href="/portal/<%= event.portal_token %>/plan-soiree" class="btn btn-outline-secondary btn-sm">Plan de soirée</a>
      </div>

      <div class="alert alert-warning small">
        Après confirmation, votre dossier sera <strong>verrouillé</strong> — vous ne pourrez plus le modifier en ligne.
        Pour tout changement par la suite, contactez DJ Carl.
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger small"><%= error %></div>
      <% } %>

      <form method="post" action="/portal/<%= event.portal_token %>/confirmer" id="confirmDossierForm" novalidate>
        <div class="mb-3">
          <label class="form-label" for="confirmed_by_name">Nom de la personne qui confirme <span class="text-danger">*</span></label>
          <input type="text" class="form-control<%= typeof error !== 'undefined' && error ? ' is-invalid' : '' %>"
                 id="confirmed_by_name" name="confirmed_by_name"
                 value="<%= typeof confirmedByName !== 'undefined' ? confirmedByName : '' %>"
                 placeholder="Ex. Marie Tremblay" required minlength="2" autocomplete="name">
          <div class="invalid-feedback">Indiquez votre nom complet pour confirmer.</div>
          <div class="form-text">Obligatoire — votre nom tel qu'il apparaîtra sur la confirmation.</div>
        </div>
        <button type="submit" class="btn btn-success btn-lg w-100" id="confirmDossierBtn" disabled>
          Tout est correct — je confirme
        </button>
      </form>

      <script>
        (function () {
          const form = document.getElementById("confirmDossierForm");
          const input = document.getElementById("confirmed_by_name");
          const button = document.getElementById("confirmDossierBtn");
          if (!form || !input || !button) return;

          function hasValidName() {
            return input.value.trim().length >= 2;
          }

          function syncButton() {
            button.disabled = !hasValidName();
          }

          input.addEventListener("input", syncButton);
          syncButton();

          form.addEventListener("submit", function (event) {
            if (!hasValidName()) {
              event.preventDefault();
              input.classList.add("is-invalid");
              input.focus();
              return;
            }

            input.classList.remove("is-invalid");
            if (!confirm("Confirmer que tout est correct ? Votre dossier sera verrouillé.")) {
              event.preventDefault();
            }
          });
        })();
      </script>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
