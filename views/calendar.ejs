<%- include('partials/head', { title }) %>
<%- include('partials/nav', { activeNav: 'calendar' }) %>

<main class="container pb-5">
  <div class="d-flex align-items-center gap-2 mb-3">
    <a href="/" class="btn btn-outline-secondary btn-sm">← Quitter</a>
  </div>
  <div class="mb-4">
    <h1 class="h3 mb-0">Calendrier</h1>
  </div>

  <% if (typeof subcontractorAdded !== 'undefined' && subcontractorAdded) { %>
    <div class="alert alert-success">Sous-traitant ajouté.</div>
  <% } %>
  <% if (typeof subcontractorError !== 'undefined' && subcontractorError) { %>
    <div class="alert alert-danger"><%= subcontractorError %></div>
  <% } %>

  <%- include('partials/calendar-views', {
    calendarBasePath: '/calendar',
    showContractLink: false,
    showDayGestionDetails: true,
    canOpenEvent: true,
    cal: cal
  }) %>

  <% if (typeof subcontractorCalendarLinks !== 'undefined' && subcontractorCalendarLinks) { %>
    <%- include('partials/subcontractor-calendar-links-card', {
      subcontractorCalendarLinks,
      returnTo: typeof subcontractorCalendarReturnTo !== 'undefined' ? subcontractorCalendarReturnTo : '/calendar'
    }) %>
  <% } %>
</main>

<%- include('partials/footer') %>
<script src="/js/contract-print.js"></script>
