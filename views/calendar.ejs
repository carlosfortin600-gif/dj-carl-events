<%- include('partials/head', { title }) %>
<%- include('partials/nav', { activeNav: 'calendar' }) %>

<main class="container pb-5">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h3 mb-0">Calendrier</h1>
    <div class="btn-group">
      <a href="/calendar?year=<%= prevMonth.year %>&month=<%= prevMonth.month %>" class="btn btn-outline-secondary">← Mois précédent</a>
      <a href="/calendar?year=<%= nextMonth.year %>&month=<%= nextMonth.month %>" class="btn btn-outline-secondary">Mois suivant →</a>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header bg-white py-3 text-center">
      <h2 class="h4 mb-0"><%= monthLabel %></h2>
    </div>
    <div class="card-body p-2 p-md-3">
      <div class="calendar-grid">
        <div class="calendar-weekday">Dim</div>
        <div class="calendar-weekday">Lun</div>
        <div class="calendar-weekday">Mar</div>
        <div class="calendar-weekday">Mer</div>
        <div class="calendar-weekday">Jeu</div>
        <div class="calendar-weekday">Ven</div>
        <div class="calendar-weekday">Sam</div>

        <% for (let i = 0; i < firstWeekday; i++) { %>
          <div class="calendar-day calendar-day-empty"></div>
        <% } %>

        <% for (let day = 1; day <= daysInMonth; day++) { %>
          <% const dateStr = year + '-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0'); %>
          <% const dayEvents = byDate[dateStr] || []; %>
          <% const isSelected = selectedDate === dateStr; %>
          <a href="/calendar?year=<%= year %>&month=<%= month %>&date=<%= dateStr %>"
             class="calendar-day <%= dayEvents.length ? 'has-events' : '' %> <%= isSelected ? 'selected' : '' %>">
            <span class="calendar-day-num"><%= day %></span>
            <% dayEvents.slice(0, 3).forEach(function(ev) { %>
              <span class="calendar-event-dot status-dot-<%= ev.status %>" title="<%= clientShortName(ev) %>"></span>
            <% }); %>
            <% if (dayEvents.length > 3) { %>
              <span class="calendar-more">+<%= dayEvents.length - 3 %></span>
            <% } %>
          </a>
        <% } %>
      </div>

      <div class="calendar-legend mt-3 d-flex flex-wrap gap-3 small">
        <span><span class="legend-dot status-dot-a_completer"></span> À compléter</span>
        <span><span class="legend-dot status-dot-en_preparation"></span> En préparation</span>
        <span><span class="legend-dot status-dot-pret"></span> Prêt</span>
        <span><span class="legend-dot status-dot-termine"></span> Terminé</span>
      </div>
    </div>
  </div>

  <% if (selectedDate && selectedEvents.length > 0) { %>
    <div class="card">
      <div class="card-header bg-white py-3">
        <h2 class="h5 mb-0">Événements du <%= formatDateFr(selectedDate) %></h2>
      </div>
      <div class="list-group list-group-flush">
        <% selectedEvents.forEach(function(ev) { %>
          <div class="list-group-item py-3">
            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
              <div>
                <strong><%= clientShortName(ev) %></strong>
                <span class="text-muted mx-1">|</span>
                <%= ev.event_type %>
                <span class="text-muted mx-1">|</span>
                <%= ev.venue || '—' %>
                <span class="badge <%= statusBadgeClass(ev.status) %> ms-2"><%= statusLabel(ev.status) %></span>
              </div>
              <a href="/events/<%= ev.id %>" class="btn btn-outline-primary btn-sm">Ouvrir</a>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } else if (selectedDate) { %>
    <div class="alert alert-light text-center">Aucun événement le <%= formatDateFr(selectedDate) %>.</div>
  <% } %>
</main>

<%- include('partials/footer') %>
