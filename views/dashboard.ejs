<%- include('partials/head', { title }) %>
<%- include('partials/nav', { activeNav }) %>

<main class="container pb-5">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <h1 class="h2 mb-1">DJ CARL — Gestion des événements</h1>
      <p class="text-muted mb-0">Tableau de bord</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if (upcoming.length > 0) { %>
        <a href="/export/dossiers.zip" class="btn btn-outline-primary btn-lg px-4">
          Télécharger les dossiers à venir (ZIP)
        </a>
      <% } %>
      <a href="/events/new" class="btn btn-primary btn-lg px-4">+ Nouvel événement</a>
    </div>
  </div>

  <% if (typeof exportEmpty !== 'undefined' && exportEmpty) { %>
    <div class="alert alert-warning">Aucun événement à venir à exporter.</div>
  <% } %>

  <% if (typeof portalNotifications !== 'undefined' && portalNotifications.length) { %>
    <div class="alert alert-info">
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
        <strong>Modifications client (<%= portalNotificationCount %>)</strong>
      </div>
      <ul class="mb-0 ps-3">
        <% portalNotifications.forEach(function(n) { %>
          <li class="mb-2">
            <a href="/events/<%= n.event_id %>?tab=client" class="fw-semibold"><%= n.clientName %></a>
            — <%= n.kindLabel %>
            <span class="text-muted">· <%= formatTimestampFr(n.created_at) %></span>
            <form method="post" action="/notifications/<%= n.id %>/read" class="d-inline ms-1">
              <input type="hidden" name="returnTo" value="/">
              <button type="submit" class="btn btn-link btn-sm p-0 align-baseline">Marquer lu</button>
            </form>
          </li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <% if (typeof emailNotificationConfigured !== 'undefined' && !emailNotificationConfigured) { %>
    <div class="alert alert-light border d-flex flex-wrap justify-content-between align-items-center gap-2">
      <span class="small">
        Les alertes client s'affichent ici. Pour aussi recevoir un courriel,
        configurez votre adresse dans les paramètres.
      </span>
      <a href="/settings/notifications" class="btn btn-sm btn-outline-primary">Mon courriel de notification</a>
    </div>
  <% } %>

  <% if (typeof deleted !== 'undefined' && deleted) { %>
    <div class="alert alert-warning">Événement déplacé dans la corbeille. Vous pouvez le restaurer ci-dessous.</div>
  <% } %>
  <% if (typeof restored !== 'undefined' && restored) { %>
    <div class="alert alert-success">Événement restauré avec succès.</div>
  <% } %>
  <% if (typeof destroyed !== 'undefined' && destroyed) { %>
    <div class="alert alert-success">Événement supprimé définitivement.</div>
  <% } %>

  <div class="row g-3 mb-4">
    <div class="col-6 col-md">
      <div class="card stat-card h-100">
        <div class="card-body text-center">
          <div class="stat-number"><%= stats.total %></div>
          <div class="stat-label">Dossiers actifs</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md">
      <div class="card stat-card h-100">
        <div class="card-body text-center">
          <div class="stat-number text-warning"><%= stats.incomplete %></div>
          <div class="stat-label">À compléter</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md">
      <div class="card stat-card h-100">
        <div class="card-body text-center">
          <div class="stat-number text-info"><%= stats.inPreparation %></div>
          <div class="stat-label">En préparation</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md">
      <div class="card stat-card h-100">
        <div class="card-body text-center">
          <div class="stat-number text-success"><%= stats.ready %></div>
          <div class="stat-label">Prêts</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md">
      <div class="card stat-card h-100">
        <div class="card-body text-center">
          <div class="stat-number text-secondary"><%= stats.done %></div>
          <div class="stat-label">Terminés</div>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header bg-white py-3">
      <h2 class="h5 mb-0">Événements à venir</h2>
    </div>
    <div class="list-group list-group-flush">
      <% if (upcoming.length === 0) { %>
        <div class="list-group-item text-muted py-4 text-center">Aucun événement à venir</div>
      <% } %>
      <% upcoming.forEach(function(ev) { %>
        <%- include('partials/event-row', { ev, expandable: true }) %>
      <% }); %>
    </div>
  </div>

  <div class="card mt-4" id="corbeille">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <h2 class="h5 mb-0">Corbeille</h2>
      <% if (stats.deleted > 0) { %>
        <span class="badge bg-secondary"><%= stats.deleted %> supprimé<%= stats.deleted !== 1 ? 's' : '' %></span>
      <% } %>
    </div>
    <div class="list-group list-group-flush">
      <% if (deletedEvents.length === 0) { %>
        <div class="list-group-item text-muted py-4 text-center">Aucun événement supprimé</div>
      <% } %>
      <% deletedEvents.forEach(function(ev) { %>
        <%- include('partials/event-row', { ev, expandable: false, trashMode: true }) %>
      <% }); %>
    </div>
  </div>

  <% if (past.length > 0) { %>
    <section class="dashboard-past-section mt-4">
      <div class="card">
        <div class="card-header py-2">
          <h2 class="h6 mb-0">Événements passés</h2>
        </div>
        <div class="list-group list-group-flush">
          <% past.forEach(function(ev) { %>
            <%- include('partials/event-row', { ev, expandable: false, pastMode: true }) %>
          <% }); %>
        </div>
      </div>
    </section>
  <% } %>
</main>

<%- include('partials/footer') %>
