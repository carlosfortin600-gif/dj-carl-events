<%- include('partials/head', { title }) %>
<%- include('partials/nav', { activeNav: 'logistique' }) %>

<main class="container-fluid px-3 px-lg-4 pb-5">
  <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-2">
    <div>
      <h1 class="h3 mb-1">Logistique</h1>
      <p class="text-muted small mb-0">
        Événements à venir — employés (contrat), départ et arrivée, client, accès et hôtel.
      </p>
    </div>
    <a href="/calendar" class="btn btn-outline-secondary btn-sm flex-shrink-0">Calendrier</a>
  </div>

  <% if (typeof logistiqueSaved !== 'undefined' && logistiqueSaved) { %>
    <div class="alert alert-success py-2">Employés enregistrés.</div>
  <% } %>
  <% if (typeof logistiqueError !== 'undefined' && logistiqueError) { %>
    <div class="alert alert-danger py-2">Enregistrement impossible — réessayez.</div>
  <% } %>

  <% if (!eventsList.length) { %>
    <p class="text-muted text-center py-5">Aucun événement à venir.</p>
  <% } else { %>
    <div class="mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
      <p class="text-muted small mb-0"><%= eventsList.length %> événement<%= eventsList.length !== 1 ? 's' : '' %> à venir — par semaine</p>
      <span class="badge bg-primary fs-6 px-3 py-2"><%= eventsList.length %></span>
    </div>
    <%- include('partials/upcoming-by-week', {
      eventsByWeek: typeof eventsByWeek !== 'undefined' ? eventsByWeek : [],
      rowType: 'logistique',
      emptyMessage: 'Aucun événement à venir.'
    }) %>
  <% } %>
</main>

<%- include('partials/footer') %>