<%- include('partials/head', { title }) %>
<%- include('partials/nav', { activeNav: 'logistique' }) %>

<main class="container-fluid px-3 px-lg-4 pb-5">
  <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-2">
    <div>
      <h1 class="h3 mb-1">Logistique</h1>
      <p class="text-muted small mb-0">
        Événements à venir — employés (contrat), départ et arrivée, client, accès et hôtel.
      </p>
    </div>
    <a href="/calendar" class="btn btn-outline-secondary btn-sm flex-shrink-0">Calendrier</a>
  </div>

  <% if (typeof logistiqueSaved !== 'undefined' && logistiqueSaved) { %>
    <div class="alert alert-success py-2">Employés enregistrés.</div>
  <% } %>
  <% if (typeof logistiqueError !== 'undefined' && logistiqueError) { %>
    <div class="alert alert-danger py-2">Enregistrement impossible — réessayez.</div>
  <% } %>
  <% if (typeof logistiqueEmailSent !== 'undefined' && logistiqueEmailSent) { %>
    <div class="alert alert-success py-2">
      Courriel envoyé (<strong><%= logistiqueEmailRecipient %></strong>).
      <% if (logistiqueEmailTo) { %>
        Destinataire : <code><%= logistiqueEmailTo %></code>.
      <% } %>
      <% if (logistiqueEmailFrom) { %>
        Expéditeur : <code><%= logistiqueEmailFrom %></code>.
      <% } %>
      Vérifiez boîte de réception et indésirables.
    </div>
  <% } %>
  <% if (typeof logistiqueEmailError !== 'undefined' && logistiqueEmailError) { %>
    <div class="alert alert-danger py-2"><%= logistiqueEmailError %></div>
  <% } %>
  <% if (typeof logisticsEmailConfigured !== 'undefined' && !logisticsEmailConfigured) { %>
    <div class="alert alert-warning py-2 small">
      Pour envoyer par courriel, configurez l’expéditeur dans
      <a href="/settings/notifications">Paramètres → Notifications</a>.
    </div>
  <% } %>

  <% if (!eventsList.length) { %>
    <p class="text-muted text-center py-5">Aucun événement à venir.</p>
  <% } else { %>
    <p class="text-muted small mb-3">
      Ligne employé : sans cadre = pas encore envoyé ·
      <span class="logistique-legend-swatch logistique-legend-swatch--sent">jaune</span> courriel envoyé ·
      <span class="logistique-legend-swatch logistique-legend-swatch--confirmed">vert</span> confirmé par l’employé.
    </p>
    <div class="mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
      <p class="text-muted small mb-0"><%= eventsList.length %> événement<%= eventsList.length !== 1 ? 's' : '' %> à venir — par semaine</p>
      <span class="badge bg-primary fs-6 px-3 py-2"><%= eventsList.length %></span>
    </div>
    <%- include('partials/upcoming-by-week', {
      eventsByWeek: typeof eventsByWeek !== 'undefined' ? eventsByWeek : [],
      rowType: 'logistique',
      emptyMessage: 'Aucun événement à venir.',
      logisticsEmailRecipients: typeof logisticsEmailRecipients !== 'undefined' ? logisticsEmailRecipients : [],
      logisticsEmailConfigured: typeof logisticsEmailConfigured !== 'undefined' ? logisticsEmailConfigured : false,
      logisticsNotificationEmail: typeof logisticsNotificationEmail !== 'undefined' ? logisticsNotificationEmail : '',
      logisticsTestDeliverTo: typeof logisticsTestDeliverTo !== 'undefined' ? logisticsTestDeliverTo : '',
      logisticsMailFrom: typeof logisticsMailFrom !== 'undefined' ? logisticsMailFrom : ''
    }) %>
  <% } %>
</main>

<%- include('partials/footer') %>