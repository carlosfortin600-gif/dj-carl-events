<%- include('partials/head', { title: 'Confirmer le planning' }) %>

<main class="container pb-5" style="max-width: 640px;">
  <div class="card mt-4">
    <div class="card-body p-4 text-center">
      <h1 class="h4 mb-2">Planning de la semaine</h1>
      <p class="text-muted mb-0"><%= weekLabel %></p>
      <p class="mb-0 mt-2">Salut <strong><%= personLabel %></strong>,</p>
    </div>
  </div>

  <div class="card mt-3 border-success">
    <div class="card-body p-4">
      <p class="mb-3">Si les horaires et endroits du courriel te conviennent, confirme en un clic.</p>
      <form method="post" action="/logistique/planning/confirmer/<%= token %>">
        <button type="submit" class="btn btn-success btn-lg w-100 fw-semibold">Tout est beau — confirmer</button>
      </form>
    </div>
  </div>
</main>

</body>
</html>