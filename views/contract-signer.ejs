<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="bg-light">
  <main class="container py-4 py-md-5" style="max-width: 52rem;">
    <div class="text-center mb-4">
      <h1 class="h4 mb-1">Signature du contrat</h1>
      <p class="text-muted mb-0">DJ Carl — <%= subcontractorLabel %></p>
    </div>

    <% if (signed) { %>
      <div class="alert alert-success">Merci ! Votre signature a été enregistrée.</div>
    <% } %>

    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4 p-md-5">
        <%- include('partials/service-contract-document', { event, contract, subcontractorLabel }) %>
      </div>
    </div>

    <% if (!contract.signature_subcontractor) { %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h2 class="h6 mb-2">Votre signature</h2>
          <p class="text-muted small">Signez avec votre doigt ou la souris, puis enregistrez.</p>
          <form method="post" action="/signer/contrat/<%= signToken %>">
            <div class="signature-pad-wrap" data-signature-pad>
              <canvas class="signature-pad-canvas" aria-label="Signature sous-traitant"></canvas>
              <input type="hidden" name="signature_subcontractor" value="">
              <button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-signature-clear>Effacer</button>
            </div>
            <button type="submit" class="btn btn-primary btn-lg mt-3">Enregistrer ma signature</button>
          </form>
        </div>
      </div>
    <% } else { %>
      <div class="alert alert-info mb-0">Ce contrat a déjà été signé. Contactez DJ Carl si vous devez le modifier.</div>
    <% } %>
  </main>

  <script src="/js/signature-pad.js?v=1"></script>
  <script src="/js/date-format-fr.js"></script>
</body>
</html>
