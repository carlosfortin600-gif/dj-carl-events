<%- include('partials/head', { title }) %>
<%- include('partials/nav', { activeNav }) %>

<main class="container pb-5" style="max-width: 720px;">
  <div class="mb-3">
    <a href="/" class="btn btn-outline-secondary btn-sm">← Tableau de bord</a>
  </div>

  <% if (saved) { %>
    <div class="alert alert-success">Paramètres enregistrés.</div>
  <% } %>
  <% if (typeof testSent !== 'undefined' && testSent) { %>
    <div class="alert alert-success">
      Courriel de test envoyé<% if (testProvider) { %> via <%= testProvider === 'resend' ? 'Resend' : 'SMTP' %><% } %>.
      <% if (typeof testFrom !== 'undefined' && testFrom) { %>
        Expéditeur : <code><%= testFrom %></code>.
      <% } %>
      Vérifiez votre boîte de réception (et les indésirables).
    </div>
  <% } %>
  <% if (typeof testError !== 'undefined' && testError) { %>
    <div class="alert alert-danger"><%= testError %></div>
  <% } %>

  <div class="card">
    <div class="card-body p-4">
      <h1 class="h4 mb-2">Notifications client</h1>
      <p class="text-muted small mb-4">
        Quand un client enregistre son questionnaire ou son plan de soirée, vous recevez une alerte
        sur le tableau de bord. Ajoutez votre courriel pour aussi recevoir un message.
        Vous recevrez aussi un courriel quand un client <strong>confirme</strong> son dossier.
      </p>
      <p class="text-muted small mb-4">
        <strong>Rappel automatique client :</strong> 6 jours avant chaque événement, un courriel est
        envoyé au client pour lui demander de confirmer que son questionnaire et vos échanges sont
        encore à jour. Une copie est envoyée à <strong>carlos.fortin.600@gmail.com</strong>
        (modifiable via <code>CONFIRMATION_EMAIL_COPY_TO</code>).
        Un domaine vérifié (Resend ou SMTP) est requis pour envoyer aux adresses des clients.
      </p>

      <form method="post" action="/settings/notifications">
        <div class="mb-4">
          <label class="form-label" for="emailTo">Mon courriel de notification</label>
          <input type="email" class="form-control" id="emailTo" name="emailTo"
                 value="<%= settings.emailTo %>"
                 placeholder="carl@votredomaine.com" autocomplete="email">
          <div class="form-text">
            <% if (typeof usesResend !== 'undefined' && usesResend) { %>
              <strong>Avec Resend sans domaine :</strong> mettez ici le courriel de votre compte Resend
              (ex. votre Gmail d'inscription), pas un autre courriel.
            <% } else { %>
              Courriel où vous voulez recevoir les avis de modification client.
            <% } %>
          </div>
        </div>

        <div class="border rounded p-3 mb-4">
          <h2 class="h6 mb-2">Resend — recommandé en ligne</h2>
          <div class="alert alert-info small py-2 mb-3">
            <strong>Première config (sans domaine) :</strong>
            <ol class="mb-0 ps-3">
              <li>Collez votre clé API Resend (<code>re_...</code>)</li>
              <li><strong>Mon courriel</strong> = <em>exactement</em> le courriel de votre compte Resend (Gmail d'inscription)</li>
              <li><strong>Expédiateur Resend</strong> = laissez vide ou <code><%= resendTestFrom %></code></li>
              <li>Enregistrer → Tester l'envoi</li>
            </ol>
            <p class="mb-0 mt-2"><strong>Important :</strong> sans domaine vérifié, Resend refuse Hotmail, Outlook, etc. Pour recevoir ailleurs, ajoutez <code>djcarl.ca</code> (ou votre domaine) sur <a href="https://resend.com/domains" target="_blank" rel="noopener">resend.com/domains</a>.</p>
          </div>
          <p class="text-muted small mb-3">
            Sans domaine vérifié, Resend n'envoie qu'à votre propre courriel de compte.
            Avec un domaine (ex. djcarl.ca), ajoutez-le dans Resend puis mettez
            <code>DJ Carl &lt;notifications@votredomaine.com&gt;</code>.
          </p>
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label" for="resendApiKey">Clé API Resend</label>
              <input type="password" class="form-control" id="resendApiKey" name="resendApiKey"
                     value="" placeholder="<%= typeof resendApiKeySet !== 'undefined' && resendApiKeySet ? '•••••••• (inchangée)' : 're_...' %>"
                     autocomplete="off">
            </div>
            <div class="col-12">
              <label class="form-label" for="resendFrom">Expéditeur Resend</label>
              <input type="text" class="form-control" id="resendFrom" name="resendFrom"
                     value="<%= settings.resendFrom %>"
                     placeholder="<%= resendTestFrom %>">
              <div class="form-text">Laissez vide pour utiliser l'expéditeur de test Resend. N'utilisez pas votre adresse Gmail ici.</div>
            </div>
          </div>
        </div>

        <div class="border rounded p-3 mb-4 bg-light">
          <h2 class="h6 mb-3">SMTP (Gmail, etc.) — optionnel</h2>
          <p class="text-muted small">
            Fonctionne bien en local. En production sur Render, préférez Resend ci-dessus.
            Gmail : serveur <code>smtp.gmail.com</code>, port <code>587</code>, mot de passe d'application.
          </p>

          <div class="row g-3">
            <div class="col-md-8">
              <label class="form-label" for="smtpHost">Serveur SMTP</label>
              <input type="text" class="form-control" id="smtpHost" name="smtpHost"
                     value="<%= settings.smtpHost %>" placeholder="smtp.gmail.com">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="smtpPort">Port</label>
              <input type="text" class="form-control" id="smtpPort" name="smtpPort"
                     value="<%= settings.smtpPort || '587' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="smtpUser">Utilisateur SMTP</label>
              <input type="email" class="form-control" id="smtpUser" name="smtpUser"
                     value="<%= settings.smtpUser %>" placeholder="votre@gmail.com" autocomplete="username">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="smtpPass">Mot de passe SMTP</label>
              <input type="password" class="form-control" id="smtpPass" name="smtpPass"
                     value="" placeholder="<%= typeof smtpPassSet !== 'undefined' && smtpPassSet ? '•••••••• (inchangé)' : 'Mot de passe d\'application' %>"
                     autocomplete="new-password">
            </div>
            <div class="col-12">
              <label class="form-label" for="smtpFrom">Expéditeur (optionnel)</label>
              <input type="text" class="form-control" id="smtpFrom" name="smtpFrom"
                     value="<%= settings.smtpFrom %>" placeholder="DJ Carl &lt;carl@votredomaine.com&gt;">
            </div>
            <div class="col-12">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="smtpSecure" value="1" id="smtpSecure"
                       <%= settings.smtpSecure ? 'checked' : '' %>>
                <label class="form-check-label" for="smtpSecure">Connexion sécurisée (SSL, port 465)</label>
              </div>
            </div>
          </div>
        </div>

        <div class="alert alert-light border small mb-4">
          <% if (emailConfigured) { %>
            <strong>Courriel actif<% if (usesResend) { %> (Resend)<% } else { %> (SMTP)<% } %>.</strong>
            Les prochaines modifications client déclencheront un message à
            <strong><%= settings.emailTo %></strong>.
            <% if (usesResend && !settings.resendFrom) { %>
              <span class="d-block mt-1">Mode test Resend : vérifiez que ce courriel est bien celui de votre compte Resend.</span>
            <% } %>
          <% } else if (settings.emailTo) { %>
            <strong>Configuration incomplète.</strong>
            Ajoutez une clé Resend + expéditeur, ou le SMTP complet (utilisateur + mot de passe).
            Les alertes dans l'app restent actives.
          <% } else { %>
            <strong>Alertes dans l'app seulement.</strong> Ajoutez votre courriel et Resend ou SMTP pour recevoir aussi un message.
          <% } %>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <button type="submit" class="btn btn-primary">Enregistrer</button>
          <button type="submit" class="btn btn-outline-secondary"
                  formaction="/settings/notifications/test" formmethod="post">
            Tester l'envoi
          </button>
        </div>
        <p class="form-text mt-2 mb-0">
          Le test utilise les valeurs du formulaire. Les mots de passe/clés enregistrés sont conservés si les champs sont vides.
        </p>
      </form>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
