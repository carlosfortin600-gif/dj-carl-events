<% 
  const view = cal.view;
  const anchorDate = cal.anchorDate;
  const year = cal.year;
  const month = cal.month;
  const periodLabel = cal.periodLabel;
  const prevQuery = cal.prevQuery;
  const nextQuery = cal.nextQuery;
  const byDate = cal.byDate;
  const daysInMonth = cal.daysInMonth;
  const firstWeekday = cal.firstWeekday;
  const todayIso = cal.todayIso;
  const weekDays = cal.weekDays;
  const dayLogistics = cal.dayLogistics;
%>
<% function calUrl(params) {
  const merged = { view: view, date: anchorDate, year: year, month: month };
  Object.assign(merged, params);
  if (merged.view === 'month') delete merged.date;
  const q = queryString(merged);
  return calendarBasePath + (q ? '?' + q : '');
} %>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
  <div class="btn-group" role="group" aria-label="Vue horaire logistique">
    <a href="<%= calUrl({ view: 'day', date: anchorDate }) %>"
       class="btn btn-sm <%= view === 'day' ? 'btn-primary' : 'btn-outline-secondary' %>">Jour</a>
    <a href="<%= calUrl({ view: 'week', date: anchorDate }) %>"
       class="btn btn-sm <%= view === 'week' ? 'btn-primary' : 'btn-outline-secondary' %>">Semaine</a>
    <a href="<%= calUrl({ view: 'month', year: year, month: month }) %>"
       class="btn btn-sm <%= view === 'month' ? 'btn-primary' : 'btn-outline-secondary' %>">Mois</a>
  </div>
  <div class="btn-group">
    <a href="<%= calUrl(prevQuery) %>" class="btn btn-outline-secondary btn-sm">← <%= cal.navPrevLabel %></a>
    <a href="<%= calUrl(nextQuery) %>" class="btn btn-outline-secondary btn-sm"><%= cal.navNextLabel %> →</a>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header bg-white py-3 text-center">
    <h2 class="h4 mb-0"><%= periodLabel %></h2>
  </div>
  <div class="card-body p-2 p-md-3">
    <% if (view === 'month') { %>
      <%- include('logistique-month-body', { calendarBasePath, year, month, byDate, daysInMonth, firstWeekday, todayIso }) %>
    <% } else if (view === 'week') { %>
      <%- include('logistique-week-body', { calendarBasePath, weekDays }) %>
    <% } else { %>
      <%- include('logistique-day-body', { dayLogistics }) %>
    <% } %>
  </div>
</div>

<div class="calendar-legend mt-1 d-flex flex-wrap gap-3 small text-muted">
  <span><span class="logistics-legend-dot logistics-kind-depart"></span> Départ</span>
  <span><span class="logistics-legend-dot logistics-kind-arrivee"></span> Arrivée / installation</span>
  <span><span class="logistics-legend-dot logistics-kind-hotel"></span> Hôtel</span>
  <span><span class="logistics-legend-dot logistics-kind-trailer"></span> Trailer</span>
  <span><span class="logistics-legend-dot logistics-kind-rappel"></span> Rappel client</span>
</div>