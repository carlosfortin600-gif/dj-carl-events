<% const specialNotes = (q.special_animation && q.special_animation.notes) ? q.special_animation.notes : ''; %>

<section class="q-section mb-4" id="animation-speciale">
  <h2 class="h5 q-section-title">Animation spéciale</h2>
  <p class="text-muted small mb-3">
    Jeux, tirages, moments festifs, chansons à prévoir… décrivez ce que vous souhaitez.
  </p>

  <div class="special-animation-card border rounded p-3">
    <textarea class="form-control border-0 shadow-none"
              name="special_animation_notes"
              rows="6"
              placeholder="Ex. : tirage de prix à 21 h, chanson surprise pour Marie, jeu des chaises musicales…"><%= specialNotes %></textarea>
  </div>
</section>
