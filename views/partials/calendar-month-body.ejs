<% function dayUrl(dateStr) {
  const q = queryString({ view: 'day', date: dateStr });
  return calendarBasePath + '?' + q;
} %>

<div class="calendar-grid">
  <div class="calendar-weekday">Dim</div>
  <div class="calendar-weekday">Lun</div>
  <div class="calendar-weekday">Mar</div>
  <div class="calendar-weekday">Mer</div>
  <div class="calendar-weekday">Jeu</div>
  <div class="calendar-weekday">Ven</div>
  <div class="calendar-weekday">Sam</div>

  <% for (let i = 0; i < firstWeekday; i++) { %>
    <div class="calendar-day calendar-day-empty"></div>
  <% } %>

  <% for (let day = 1; day <= daysInMonth; day++) { %>
    <% const dateStr = year + '-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0'); %>
    <% const dayEvents = byDate[dateStr] || []; %>
    <% const isSelected = selectedDate === dateStr; %>
    <div class="calendar-day <%= dayEvents.length ? 'has-events' : '' %> <%= isSelected ? 'selected' : '' %>">
      <a href="<%= dayUrl(dateStr) %>" class="calendar-day-head text-decoration-none">
        <span class="calendar-day-num"><%= day %></span>
      </a>
      <% if (dayEvents.length) { %>
        <div class="calendar-month-events">
          <% dayEvents.forEach(function(ev) { %>
            <% const city = eventCity(ev); %>
            <div class="calendar-month-event status-border-<%= ev.status %>">
              <div class="calendar-month-event-name"><%= calendarEventPrimary(ev) %></div>
              <% if (city) { %>
                <div class="calendar-month-event-city"><%= city %></div>
              <% } %>
              <% if (ev.phone) { %>
                <% if (telHref(ev.phone)) { %>
                  <a href="<%= telHref(ev.phone) %>" class="calendar-month-event-phone"><%= formatPhoneDisplay(ev.phone) %></a>
                <% } else { %>
                  <div class="calendar-month-event-phone text-muted"><%= formatPhoneDisplay(ev.phone) %></div>
                <% } %>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
