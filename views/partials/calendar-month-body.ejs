<% function dayUrl(dateStr) {
  const q = queryString({ view: 'day', date: dateStr });
  return calendarBasePath + '?' + q;
} %>

<div class="calendar-grid">
  <div class="calendar-weekday">Dim</div>
  <div class="calendar-weekday">Lun</div>
  <div class="calendar-weekday">Mar</div>
  <div class="calendar-weekday">Mer</div>
  <div class="calendar-weekday">Jeu</div>
  <div class="calendar-weekday">Ven</div>
  <div class="calendar-weekday">Sam</div>

  <% for (let i = 0; i < firstWeekday; i++) { %>
    <div class="calendar-day calendar-day-empty"></div>
  <% } %>

  <% for (let day = 1; day <= daysInMonth; day++) { %>
    <% const dateStr = year + '-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0'); %>
    <% const dayEvents = byDate[dateStr] || []; %>
    <% const isSelected = selectedDate === dateStr; %>
    <% const isToday = typeof todayIso !== 'undefined' && todayIso === dateStr; %>
    <div class="calendar-day <%= dayEvents.length ? 'has-events' : '' %> <%= isSelected ? 'selected' : '' %> <%= isToday ? 'is-today' : '' %>">
      <a href="<%= dayUrl(dateStr) %>" class="calendar-day-head text-decoration-none">
        <span class="calendar-day-num"><%= day %></span>
      </a>
      <% if (dayEvents.length) { %>
        <div class="calendar-month-events">
          <% dayEvents.forEach(function(ev) { %>
            <% const evHref = ev.isClientCallback ? ev.gestionDepartUrl : '/events/' + ev.id; %>
            <% const evBorderClass = ev.isClientCallback ? 'calendar-month-event--callback' : 'status-border-' + ev.status; %>
            <% if (typeof canOpenEvent !== 'undefined' && canOpenEvent) { %>
              <a href="<%= evHref %>" class="calendar-month-event calendar-month-event-link <%= evBorderClass %>">
                <div class="calendar-month-event-name"><%= ev.isClientCallback ? ev.calendarEntryPrimary : calendarEventPrimary(ev) %></div>
                <div class="calendar-month-event-city"><%= ev.isClientCallback ? ev.calendarEntrySubtitle : (eventCity(ev) || '—') %></div>
                <% if (!ev.isClientCallback && ev.thematicSummary) { %>
                  <div class="calendar-month-event-thematic"><%= ev.thematicSummary %></div>
                <% } %>
              </a>
            <% } else { %>
              <div class="calendar-month-event <%= evBorderClass %>">
                <div class="calendar-month-event-name"><%= ev.isClientCallback ? ev.calendarEntryPrimary : calendarEventPrimary(ev) %></div>
                <div class="calendar-month-event-city"><%= ev.isClientCallback ? ev.calendarEntrySubtitle : (eventCity(ev) || '—') %></div>
                <% if (!ev.isClientCallback && ev.thematicSummary) { %>
                  <div class="calendar-month-event-thematic"><%= ev.thematicSummary %></div>
                <% } %>
              </div>
            <% } %>
          <% }); %>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
