  <section class="music-section">
    <h2 class="h5 q-section-title">Musique cocktail</h2>
    <p class="text-muted small mb-2">Style(s) souhaité(s) pendant le cocktail</p>
    <div class="row g-2 mb-3">
      <% COCKTAIL_STYLES.forEach(function(style) { %>
        <div class="col-6 col-md-4 col-lg-3">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="cocktail_styles" value="<%= style %>"
                   id="cocktail_<%= style.replace(/\s+/g, '_') %>"
                   <%= (music.cocktailStyles || []).includes(style) ? 'checked' : '' %>>
            <label class="form-check-label" for="cocktail_<%= style.replace(/\s+/g, '_') %>"><%= style %></label>
          </div>
        </div>
      <% }); %>
    </div>
    <div class="mb-3">
      <label class="form-label">Lien Spotify (playlist ou album)</label>
      <input type="url" class="form-control" name="cocktail_spotify"
             placeholder="https://open.spotify.com/playlist/…"
             value="<%= music.cocktailSpotify || '' %>">
    </div>
    <div>
      <label class="form-label">Notes</label>
      <textarea class="form-control" name="cocktail_notes" rows="3"
                placeholder="Précisions pour la musique de cocktail…"><%= music.cocktailNotes || '' %></textarea>
    </div>
  </section>

  <section class="music-section">
    <h2 class="h5 q-section-title">Musique souper</h2>
    <p class="text-muted small mb-2">Style(s) souhaité(s) pendant le repas / souper</p>
    <div class="row g-2 mb-3">
      <% COCKTAIL_STYLES.forEach(function(style) { %>
        <div class="col-6 col-md-4 col-lg-3">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="dinner_styles" value="<%= style %>"
                   id="dinner_<%= style.replace(/\s+/g, '_') %>"
                   <%= (music.dinnerStyles || []).includes(style) ? 'checked' : '' %>>
            <label class="form-check-label" for="dinner_<%= style.replace(/\s+/g, '_') %>"><%= style %></label>
          </div>
        </div>
      <% }); %>
    </div>
    <div class="mb-3">
      <label class="form-label">Lien Spotify (playlist ou album)</label>
      <input type="url" class="form-control" name="dinner_spotify"
             placeholder="https://open.spotify.com/playlist/…"
             value="<%= music.dinnerSpotify || '' %>">
    </div>
    <div>
      <label class="form-label">Notes</label>
      <textarea class="form-control" name="dinner_notes" rows="3"
                placeholder="Précisions pour la musique de souper…"><%= music.dinnerNotes || '' %></textarea>
    </div>
  </section>
