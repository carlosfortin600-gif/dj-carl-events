<section class="form-section form-section-technique-date-prix mb-4">
  <h2 class="form-section-title">Date et prix</h2>
  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <label class="form-label" for="tech_departure_datetime">Départ — date et heure</label>
      <%- include('datetime-fr-field', {
        id: 'tech_departure_datetime',
        name: 'tech_departure_datetime',
        value: endDatetimeLocalValue(event.event_date, djNotes.tech_departure_date, djNotes.tech_departure_time),
        displayValue: djNotes.tech_departure_date
          ? formatDateTimeFr(djNotes.tech_departure_date, djNotes.tech_departure_time) : ''
      }) %>
    </div>
    <div class="col-md-6">
      <label class="form-label" for="tech_arrival_datetime">Arrivée — date et heure</label>
      <%- include('datetime-fr-field', {
        id: 'tech_arrival_datetime',
        name: 'tech_arrival_datetime',
        value: endDatetimeLocalValue(event.event_date, djNotes.tech_arrival_date, djNotes.tech_arrival_time),
        displayValue: djNotes.tech_arrival_date
          ? formatDateTimeFr(djNotes.tech_arrival_date, djNotes.tech_arrival_time) : ''
      }) %>
    </div>
    <div class="col-md-6">
      <label class="form-label" for="tech_charged_price">Prix chargé</label>
      <input type="text" class="form-control" id="tech_charged_price" name="tech_charged_price"
             value="<%= djNotes.tech_charged_price || '' %>"
             placeholder="Ex. : 189 $ + taxes">
    </div>
  </div>

  <% const clientCalled = djNotes.tech_client_called
    || ((djNotes.tech_client_call_date || djNotes.tech_client_call_time) ? 'yes' : 'no'); %>
  <div class="border rounded p-3 bg-light mb-4">
    <h3 class="h6 mb-3">Client</h3>
    <div class="row g-3">
      <div class="col-12">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
          <span class="fw-semibold">Client appelé</span>
          <div class="btn-group btn-group-sm" role="group" aria-label="Client appelé">
            <input type="radio" class="btn-check" name="tech_client_called" id="tech_client_called_yes" value="yes"
                   <%= clientCalled === 'yes' ? 'checked' : '' %>>
            <label class="btn btn-outline-secondary" for="tech_client_called_yes">Oui</label>
            <input type="radio" class="btn-check" name="tech_client_called" id="tech_client_called_no" value="no"
                   <%= clientCalled === 'no' ? 'checked' : '' %>>
            <label class="btn btn-outline-secondary" for="tech_client_called_no">Non</label>
          </div>
        </div>
      </div>
      <div id="tech_client_call_fields" class="col-md-6" <%= clientCalled === 'no' ? 'hidden' : '' %>>
        <label class="form-label" for="tech_client_call_datetime">Date de l'appel</label>
        <%- include('datetime-fr-field', {
          id: 'tech_client_call_datetime',
          name: 'tech_client_call_datetime',
          value: endDatetimeLocalValue(event.event_date, djNotes.tech_client_call_date, djNotes.tech_client_call_time),
          displayValue: djNotes.tech_client_call_date
            ? formatDateTimeFr(djNotes.tech_client_call_date, djNotes.tech_client_call_time) : ''
        }) %>
      </div>
      <div class="col-md-6">
        <label class="form-label" for="tech_callback_name">Nom — rappel</label>
        <input type="text" class="form-control" id="tech_callback_name" name="tech_callback_name"
               value="<%= djNotes.tech_callback_name || '' %>"
               placeholder="Personne à rappeler">
      </div>
      <div class="col-md-6">
        <label class="form-label" for="tech_callback_datetime">Date — rappel</label>
        <%- include('datetime-fr-field', {
          id: 'tech_callback_datetime',
          name: 'tech_callback_datetime',
          value: endDatetimeLocalValue(event.event_date, djNotes.tech_callback_date, djNotes.tech_callback_time),
          displayValue: djNotes.tech_callback_date
            ? formatDateTimeFr(djNotes.tech_callback_date, djNotes.tech_callback_time) : ''
        }) %>
      </div>
    </div>
  </div>

  <% const questionnaireSentGestion = djNotes.tech_questionnaire_sent
    || ((djNotes.tech_questionnaire_sent_date || djNotes.tech_questionnaire_sent_time) ? 'yes' : 'no'); %>
  <div class="border rounded p-3 bg-light mb-4">
    <h3 class="h6 mb-3">Questionnaire</h3>
    <div class="row g-3">
      <div class="col-12">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
          <span class="fw-semibold">Questionnaire envoyé</span>
          <div class="btn-group btn-group-sm" role="group" aria-label="Questionnaire envoyé">
            <input type="radio" class="btn-check" name="tech_questionnaire_sent" id="tech_questionnaire_sent_yes" value="yes"
                   <%= questionnaireSentGestion === 'yes' ? 'checked' : '' %>>
            <label class="btn btn-outline-secondary" for="tech_questionnaire_sent_yes">Oui</label>
            <input type="radio" class="btn-check" name="tech_questionnaire_sent" id="tech_questionnaire_sent_no" value="no"
                   <%= questionnaireSentGestion === 'no' ? 'checked' : '' %>>
            <label class="btn btn-outline-secondary" for="tech_questionnaire_sent_no">Non</label>
          </div>
        </div>
      </div>
      <div id="tech_questionnaire_sent_fields" class="col-md-6" <%= questionnaireSentGestion === 'no' ? 'hidden' : '' %>>
        <label class="form-label" for="tech_questionnaire_sent_datetime">Date d'envoi</label>
        <%- include('datetime-fr-field', {
          id: 'tech_questionnaire_sent_datetime',
          name: 'tech_questionnaire_sent_datetime',
          value: endDatetimeLocalValue(event.event_date, djNotes.tech_questionnaire_sent_date, djNotes.tech_questionnaire_sent_time),
          displayValue: djNotes.tech_questionnaire_sent_date
            ? formatDateTimeFr(djNotes.tech_questionnaire_sent_date, djNotes.tech_questionnaire_sent_time) : ''
        }) %>
      </div>
    </div>
  </div>

  <% if (typeof eventAgreementStatuses !== 'undefined' && eventAgreementStatuses.length) { %>
    <div class="border rounded p-3 bg-light">
      <h3 class="h6 mb-3">Ententes</h3>
      <div class="table-responsive">
        <table class="table table-sm table-bordered mb-0 bg-white">
          <thead class="table-light">
            <tr>
              <th></th>
              <% eventAgreementStatuses.forEach(function(st) { %>
                <th class="text-center"><%= st.label %></th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="text-muted">Entente passée</td>
              <% eventAgreementStatuses.forEach(function(st) { %>
                <td class="text-center fw-semibold"><%= st.passed ? 'Oui' : 'Non' %></td>
              <% }); %>
            </tr>
            <tr>
              <td class="text-muted">Signé</td>
              <% eventAgreementStatuses.forEach(function(st) { %>
                <td class="text-center fw-semibold <%= st.signed ? 'text-success' : '' %>"><%= st.signed ? 'Oui' : 'Non' %></td>
              <% }); %>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="d-flex flex-wrap gap-2 mt-3">
        <% eventAgreementStatuses.forEach(function(st) { %>
          <a href="/events/<%= event.id %>?tab=gestion&gestion=contrat&sousTraitant=<%= st.id %>"
             class="btn btn-sm btn-outline-primary">Contrat <%= st.label %></a>
        <% }); %>
      </div>
    </div>
  <% } %>
</section>
