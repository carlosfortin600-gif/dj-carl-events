<div class="datetime-fr-picker">
  <input type="text" class="form-control datetime-fr-display" readonly
         value="<%= displayValue || '' %>"
         placeholder="Choisir date et heure"
         aria-haspopup="dialog">
  <input type="datetime-local" class="datetime-fr-native" id="<%= id %>" name="<%= name %>"
         value="<%= value || '' %>">
</div>
