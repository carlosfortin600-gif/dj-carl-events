<% const list = agreementsList || []; %>

<% if (!list.length) { %>
  <p class="text-muted text-center py-4 mb-0">Aucun événement planifié.</p>
<% } else { %>
  <div class="calendar-ententes-list">
    <% list.forEach(function(ev) { %>
      <div class="calendar-event-card calendar-ententes-item status-border-<%= ev.status %> mb-3">
        <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap mb-2">
          <div>
            <div class="fw-semibold"><%= formatDateFr(ev.contractStartDate || ev.event_date) %><% if (ev.contractStartTime || ev.start_time) { %> · <%= formatTime(ev.contractStartTime || ev.start_time) %><% } %></div>
            <div class="text-muted small">
              <%= ev.event_type %><% if (ev.venue) { %> · <%= ev.venue %><% } %>
            </div>
          </div>
          <span class="badge <%= statusBadgeClass(ev.status) %>"><%= statusLabel(ev.status) %></span>
        </div>

        <%- include('calendar-agreement-summary', { ev, showAgreementSummary: true }) %>

        <div class="d-flex gap-2 mt-2 flex-wrap">
          <%- include('calendar-contract-btn', {
            ev,
            subcontractorLabel: typeof subcontractorLabel !== 'undefined' ? subcontractorLabel : '',
            showContractLink: typeof showContractLink !== 'undefined' ? showContractLink : true,
            showAgreementSummary: true,
            publicCalendarMode: typeof publicCalendarMode !== 'undefined' ? publicCalendarMode : false
          }) %>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>
