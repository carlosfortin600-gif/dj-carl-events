<% const list = agreementsByWeek || []; %>
<% const flatList = agreementsList || []; %>

<% if (!list.length && !flatList.length) { %>
  <p class="text-muted text-center py-4 mb-0">Aucun événement planifié.</p>
<% } else if (!list.length) { %>
  <%- include('calendar-ententes-items', {
    events: flatList,
    subcontractorLabel: typeof subcontractorLabel !== 'undefined' ? subcontractorLabel : '',
    publicCalendarMode: typeof publicCalendarMode !== 'undefined' ? publicCalendarMode : false
  }) %>
<% } else { %>
  <div class="calendar-ententes-by-week">
    <% list.forEach(function(week) { %>
      <section class="calendar-ententes-week mb-4">
        <h3 class="calendar-ententes-week-title h6 text-muted mb-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
          <span>Semaine du <%= week.weekLabel %></span>
          <% if (week.contractsTotalLabel) { %>
            <span class="calendar-ententes-week-total">Total prix chargé : <strong><%= week.contractsTotalLabel %></strong></span>
          <% } %>
        </h3>
        <%- include('calendar-ententes-items', {
          events: week.events,
          subcontractorLabel: typeof subcontractorLabel !== 'undefined' ? subcontractorLabel : '',
          publicCalendarMode: typeof publicCalendarMode !== 'undefined' ? publicCalendarMode : false
        }) %>
      </section>
    <% }); %>
  </div>
<% } %>
