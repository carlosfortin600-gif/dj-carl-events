<% const contractFullySigned = !!(contract.signature_contractant && contract.signature_subcontractor); %>
<div class="card mb-4 <%= contractFullySigned ? 'border-success contract-sign-card--signed' : 'border-info' %>">
  <div class="card-header py-3 <%= contractFullySigned ? 'bg-success text-white' : 'bg-info text-dark' %>">
    <h2 class="h6 mb-0"><%= contractFullySigned ? 'Contrat signé' : 'Envoyer pour signature' %></h2>
  </div>
  <div class="card-body">
    <ol class="small text-muted mb-3 ps-3">
      <li class="mb-1">Remplissez le contrat et signez la case <strong>DJ Carl</strong>.</li>
      <li class="mb-1">Cliquez sur <strong>Enregistrer le contrat</strong>.</li>
      <li class="mb-1">Copiez le lien ci-dessous et envoyez-le par texto ou courriel à <strong><%= subcontractorLabel %></strong>.</li>
      <li class="mb-1">Le sous-traitant ouvre le lien sur son téléphone, lit le contrat et signe.</li>
      <li>Quand les deux signatures sont présentes, utilisez <strong>Ouvrir pour impression</strong> ou téléchargez le PDF.</li>
    </ol>

    <label class="form-label small fw-semibold">Lien de signature pour <%= subcontractorLabel %></label>
    <div class="input-group mb-2">
      <input type="text" class="form-control font-monospace small" id="contractSignLinkPrimary" readonly value="<%= contractSignLinks.primary %>">
      <button type="button" class="btn btn-outline-primary" data-copy-target="contractSignLinkPrimary">Copier</button>
    </div>

    <% if (contractSignLinks.lan) { %>
      <label class="form-label small fw-semibold mt-3">Lien réseau local (téléphone sur le même Wi‑Fi)</label>
      <div class="input-group mb-2">
        <input type="text" class="form-control font-monospace small" id="contractSignLinkLan" readonly value="<%= contractSignLinks.lan %>">
        <button type="button" class="btn btn-outline-secondary" data-copy-target="contractSignLinkLan">Copier</button>
      </div>
    <% } %>

    <div class="d-flex flex-wrap gap-2 mt-3">
      <a href="<%= contractSignLinks.primary %>" target="_blank" rel="noopener" class="btn btn-sm btn-primary">Ouvrir le lien de signature</a>
    </div>

    <hr class="my-4">
    <h3 class="h6 mb-2">Envoyer par courriel</h3>
    <% if (typeof contractEmailSent !== 'undefined' && contractEmailSent) { %>
      <div class="alert alert-success py-2 small mb-2">Courriel envoyé.</div>
    <% } %>
    <% if (typeof contractEmailError !== 'undefined' && contractEmailError) { %>
      <div class="alert alert-danger py-2 small mb-2"><%= contractEmailError %></div>
    <% } %>
    <% if (typeof emailNotificationConfigured !== 'undefined' && !emailNotificationConfigured) { %>
      <div class="alert alert-warning py-2 small mb-0">
        Courriel non configuré.
        <a href="/settings/notifications">Paramètres → Notifications</a>
      </div>
    <% } else if (typeof contractSavedInDb !== 'undefined' && !contractSavedInDb) { %>
      <div class="alert alert-warning py-2 small mb-0">Enregistrez le contrat une première fois avant d'envoyer le courriel.</div>
    <% } else { %>
      <form method="post" action="/events/<%= event.id %>/gestion/contrat/<%= typeof subcontractorId !== 'undefined' ? subcontractorId : '' %>/email/send" class="row g-2 align-items-end">
        <div class="col-md-8">
          <label class="form-label small mb-1" for="contract_email_send">Courriel</label>
          <input type="email" class="form-control" id="contract_email_send" name="email" required
                 value="<%= contract.email || '' %>" placeholder="sous-traitant@exemple.com" autocomplete="email">
        </div>
        <div class="col-md-4">
          <button type="submit" class="btn btn-primary w-100">Envoyer le courriel</button>
        </div>
      </form>
      <p class="text-muted small mt-2 mb-0">Le message contient le lien de signature pour <%= subcontractorLabel %>.</p>
    <% } %>

    <% if (contractFullySigned) { %>
      <div class="alert alert-success py-2 small mt-3 mb-0">
        <strong>Contrat signé par les deux parties.</strong> Utilisez <strong>Ouvrir pour impression</strong> pour le PDF.
      </div>
    <% } else if (contract.signature_subcontractor) { %>
      <div class="alert alert-success py-2 small mt-3 mb-0">
        Signature du sous-traitant reçue<% if (contract.signature_subcontractor_date || contract.updated_at) { %>
          le <%= formatTimestampFr(contract.signature_subcontractor_date || contract.updated_at) %><% } %>.
      </div>
    <% } else { %>
      <div class="alert alert-warning py-2 small mt-3 mb-0">En attente de la signature de <%= subcontractorLabel %>.</div>
    <% } %>
  </div>
</div>
