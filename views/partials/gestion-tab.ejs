<% if (notesSaved) { %>
  <div class="alert alert-success">Informations enregistrées.</div>
<% } %>
<% if (contractSaved) { %>
  <div class="alert alert-success">Contrat enregistré.</div>
<% } %>
<% if (typeof contractError !== 'undefined' && contractError) { %>
  <div class="alert alert-danger"><%= contractError %></div>
<% } %>
<% if (typeof contractCleared !== 'undefined' && contractCleared) { %>
  <div class="alert alert-success">Contrat effacé.</div>
<% } %>
<% if (filesUploaded) { %>
  <div class="alert alert-success">Fichier(s) téléversé(s).</div>
<% } %>
<% if (fileDeleted) { %>
  <div class="alert alert-success">Fichier supprimé.</div>
<% } %>
<% if (filesError) { %>
  <div class="alert alert-danger"><%= filesError %></div>
<% } %>
<% if (typeof timeSpentSaved !== 'undefined' && timeSpentSaved) { %>
  <div class="alert alert-success">Temps passé enregistré.</div>
<% } %>
<% if (typeof timeSpentDeleted !== 'undefined' && timeSpentDeleted) { %>
  <div class="alert alert-success">Entrée supprimée.</div>
<% } %>

<%- include('gestion-nav', { event, gestionSection }) %>

<% if (gestionSection === 'location') { %>
  <form method="post" action="/events/<%= event.id %>/notes/save" data-unsaved-guard>
    <input type="hidden" name="return_tab" value="gestion">
    <input type="hidden" name="save_scope" value="location">
    <input type="hidden" name="gestion_section" value="location">
    <%- include('gestion-location-fields', { event, djNotes }) %>
    <% if (djNotes.updated_at) { %>
      <p class="text-muted small">Dernière modification : <%= formatTimestampFr(djNotes.updated_at) %></p>
    <% } %>
    <button type="submit" class="btn btn-primary btn-lg">Enregistrer</button>
  </form>

<% } else if (gestionSection === 'depart') { %>
  <form method="post" action="/events/<%= event.id %>/notes/save" data-unsaved-guard>
    <input type="hidden" name="return_tab" value="gestion">
    <input type="hidden" name="save_scope" value="depart">
    <input type="hidden" name="gestion_section" value="depart">
    <%- include('gestion-depart-fields', { event, djNotes }) %>
    <% if (djNotes.updated_at) { %>
      <p class="text-muted small">Dernière modification : <%= formatTimestampFr(djNotes.updated_at) %></p>
    <% } %>
    <button type="submit" class="btn btn-primary btn-lg">Enregistrer</button>
  </form>

  <div class="border rounded p-3 bg-light mt-4">
    <%- include('client-contact-panel', {
      eventId: event.id,
      clientContactLogs: typeof clientContactLogs !== 'undefined' ? clientContactLogs : [],
      returnTo: '/events/' + event.id + '?tab=gestion&gestion=depart',
      defaultContactDatetime: typeof clientContactDefaultDatetime !== 'undefined'
        ? clientContactDefaultDatetime
        : defaultQuestionnaireSentDatetime()
    }) %>
  </div>

  <%- include('gestion-ententes-panel', {
    event,
    eventAgreementStatuses: typeof eventAgreementStatuses !== 'undefined' ? eventAgreementStatuses : []
  }) %>

  <div class="border rounded p-3 bg-light mt-4">
    <h3 class="h6 mb-3">Courriels</h3>
    <%- include('email-rdv-sent-panel', {
      eventId: event.id,
      emailRdvSentLogs: typeof emailRdvSentLogs !== 'undefined' ? emailRdvSentLogs : [],
      returnTo: '/events/' + event.id + '?tab=gestion&gestion=depart',
      defaultSentDatetime: typeof emailRdvSentDefaultDatetime !== 'undefined'
        ? emailRdvSentDefaultDatetime
        : defaultQuestionnaireSentDatetime()
    }) %>
  </div>

  <div class="border rounded p-3 bg-light mt-4">
    <h3 class="h6 mb-3">Questionnaire</h3>
    <%- include('questionnaire-sent-panel', {
      eventId: event.id,
      eventDate: event.event_date,
      questionnaireSentLogs: typeof questionnaireSentLogs !== 'undefined' ? questionnaireSentLogs : [],
      returnTo: '/events/' + event.id + '?tab=gestion&gestion=depart',
      defaultSentDatetime: typeof questionnaireSentDefaultDatetime !== 'undefined'
        ? questionnaireSentDefaultDatetime
        : defaultQuestionnaireSentDatetime()
    }) %>
  </div>

<% } else if (gestionSection === 'contrat') { %>
  <%- include('gestion-contrat', {
    event,
    subcontractors,
    sousTraitant,
    contract: subcontractorContract,
    contractSaved,
    contractCleared: typeof contractCleared !== 'undefined' ? contractCleared : false,
    contractError: typeof contractError !== 'undefined' ? contractError : '',
    contractSignLinks: typeof contractSignLinks !== 'undefined' ? contractSignLinks : null,
    contractSavedInDb: typeof contractSavedInDb !== 'undefined' ? contractSavedInDb : false,
    calendarShareLinks: typeof calendarShareLinks !== 'undefined' ? calendarShareLinks : null
  }) %>

<% } else if (gestionSection === 'temps') { %>
  <%- include('gestion-temps-passe', {
    event,
    timeSpentLogs,
    timeSpentTotalHours,
    timeSpentDefaultDatetime,
    timeSpentError: typeof timeSpentError !== 'undefined' ? timeSpentError : ''
  }) %>

<% } else if (gestionSection === 'fichiers') { %>
  <%- include('gestion-fichiers', {
    event,
    eventFiles,
    maxFileSize,
    maxFilesPerUpload
  }) %>
<% } %>
