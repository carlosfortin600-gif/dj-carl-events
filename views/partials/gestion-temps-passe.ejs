<% const logs = typeof timeSpentLogs !== 'undefined' ? timeSpentLogs : []; %>
<% const totalHours = typeof timeSpentTotalHours !== 'undefined' ? timeSpentTotalHours : 0; %>
<% const activities = typeof TIME_SPENT_ACTIVITIES !== 'undefined' ? TIME_SPENT_ACTIVITIES : []; %>
<% const durations = typeof TIME_SPENT_DURATIONS !== 'undefined' ? TIME_SPENT_DURATIONS : []; %>
<% const defaultDt = typeof timeSpentDefaultDatetime !== 'undefined' ? timeSpentDefaultDatetime : ''; %>

<section class="form-section form-section-gestion mb-4">
  <h2 class="form-section-title">Temps passé</h2>
  <p class="text-muted small mb-3">
    Enregistrez le temps consacré à cet événement (appels, courriels, préparation…).
    Pour <strong>Tél.</strong>, <strong>E-mail</strong> ou <strong>Rencontre Teams</strong>, une ligne est aussi ajoutée dans
    <strong>Client contacté</strong> (Gestion → Départ) avec le type d’activité et le descriptif.
  </p>

  <% if (typeof timeSpentError !== 'undefined' && timeSpentError) { %>
    <div class="alert alert-danger py-2"><%= timeSpentError %></div>
  <% } %>

  <form method="post" action="/events/<%= event.id %>/gestion/temps/add" class="card bg-light mb-4" data-time-spent-add-form>
    <div class="card-body">
      <div class="row g-3 align-items-end">
        <div class="col-md-3">
          <label class="form-label" for="time_spent_activity">Activité</label>
          <select class="form-select" id="time_spent_activity" name="activity" required>
            <option value="">— Choisir —</option>
            <% activities.forEach(function(item) { %>
              <option value="<%= item.id %>"><%= item.label %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label" for="time_spent_logged_datetime">Date et heure</label>
          <%- include('datetime-fr-field', {
            id: 'time_spent_logged_datetime',
            name: 'logged_datetime',
            value: defaultDt,
            displayValue: defaultDt ? formatDateTimeFr(defaultDt.slice(0, 10), defaultDt.slice(11, 16)) : ''
          }) %>
        </div>
        <div class="col-md-3">
          <label class="form-label" for="time_spent_duration_hours">Durée <span class="text-muted fw-normal">(par 5 min)</span></label>
          <select class="form-select" id="time_spent_duration_hours" name="duration_hours" required>
            <option value="">— Choisir —</option>
            <% durations.forEach(function(item) { %>
              <option value="<%= String(item.value) %>"><%= item.label %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary w-100">Ajouter</button>
        </div>
        <div class="col-md-4">
          <label class="form-label" for="time_spent_contact_person">Personne contact</label>
          <input type="text" class="form-control" id="time_spent_contact_person" name="contact_person"
                 placeholder="Nom (Tél., courriel, Teams…)">
        </div>
        <div class="col-md-4">
          <span class="form-label d-block">Qui ?</span>
          <%- include('contact-party-field', {
            contactPartyFieldName: 'contact_party',
            contactPartyFieldId: 'time_spent_contact_party',
            contactPartyValue: 'client'
          }) %>
        </div>
        <div class="col-md-4">
          <label class="form-label" for="time_spent_description">Descriptif</label>
          <input type="text" class="form-control" id="time_spent_description" name="description"
                 placeholder="Ex. : sujet de l’appel, précisions…">
        </div>
      </div>
    </div>
  </form>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="h6 mb-0">Historique</h3>
    <% if (logs.length) { %>
      <span class="badge bg-primary fs-6 px-3 py-2">
        Total : <%= formatDurationHours(totalHours) %>
      </span>
    <% } %>
  </div>

  <% if (!logs.length) { %>
    <p class="text-muted mb-0">Aucun temps enregistré pour cet événement.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-sm table-bordered align-middle mb-0 bg-white time-spent-table">
        <thead class="table-light">
          <tr>
            <th>Activité</th>
            <th>Personne contact</th>
            <th>Descriptif</th>
            <th>Date et heure</th>
            <th>Durée</th>
            <th class="text-end" style="width: 9rem;"></th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(function(log) {
            const editOpen = String(typeof editTimeSpent !== 'undefined' ? editTimeSpent : '') === String(log.id);
            const logDt = loggedDatetimeLocalValue(log.logged_date, log.logged_time);
            const selectedDurationMins = Math.round(Number(log.duration_hours) * 60 / 5) * 5;
          %>
            <tr>
              <td><%= activityLabel(log.activity) %></td>
              <td><%= formatContactPersonDisplay(log.contact_person, log.contact_party) || '—' %></td>
              <td class="text-break"><%= log.description || '—' %></td>
              <td><%= formatLoggedAt(log.logged_date, log.logged_time) %></td>
              <td><%= formatDurationHours(log.duration_hours) %></td>
              <td class="text-end">
                <button type="button" class="btn btn-sm btn-outline-primary"
                        data-bs-toggle="collapse" data-bs-target="#time-spent-edit-<%= log.id %>"
                        aria-expanded="<%= editOpen ? 'true' : 'false' %>">
                  Modifier
                </button>
                <form method="post" action="/events/<%= event.id %>/gestion/temps/<%= log.id %>/delete" class="d-inline"
                      onsubmit="return confirm('Supprimer cette entrée ?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                </form>
              </td>
            </tr>
            <tr class="collapse<%= editOpen ? ' show' : '' %>" id="time-spent-edit-<%= log.id %>">
              <td colspan="6" class="bg-light p-3">
                <form method="post" action="/events/<%= event.id %>/gestion/temps/<%= log.id %>/update" data-time-spent-edit-form>
                  <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                      <label class="form-label" for="time_spent_activity_<%= log.id %>">Activité</label>
                      <select class="form-select" id="time_spent_activity_<%= log.id %>" name="activity" required>
                        <% activities.forEach(function(item) { %>
                          <option value="<%= item.id %>" <%= log.activity === item.id ? 'selected' : '' %>><%= item.label %></option>
                        <% }); %>
                      </select>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label" for="time_spent_logged_datetime_<%= log.id %>">Date et heure</label>
                      <%- include('datetime-fr-field', {
                        id: 'time_spent_logged_datetime_' + log.id,
                        name: 'logged_datetime',
                        value: logDt,
                        displayValue: logDt ? formatDateTimeFr(logDt.slice(0, 10), logDt.slice(11, 16)) : ''
                      }) %>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label" for="time_spent_duration_<%= log.id %>">Durée (5 min)</label>
                      <select class="form-select" id="time_spent_duration_<%= log.id %>" name="duration_hours" required>
                        <% durations.forEach(function(item) { %>
                          <option value="<%= String(item.value) %>" <%= item.minutes === selectedDurationMins ? 'selected' : '' %>><%= item.label %></option>
                        <% }); %>
                      </select>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                      <button type="submit" class="btn btn-primary flex-grow-1">Enregistrer</button>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label" for="time_spent_contact_person_<%= log.id %>">Personne contact</label>
                      <input type="text" class="form-control" id="time_spent_contact_person_<%= log.id %>" name="contact_person"
                             value="<%= log.contact_person || '' %>" placeholder="Nom">
                    </div>
                    <div class="col-md-4">
                      <span class="form-label d-block">Qui ?</span>
                      <%- include('contact-party-field', {
                        contactPartyFieldName: 'contact_party',
                        contactPartyFieldId: 'time_spent_contact_party_' + log.id,
                        contactPartyValue: log.contact_party || 'client'
                      }) %>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label" for="time_spent_description_<%= log.id %>">Descriptif</label>
                      <input type="text" class="form-control" id="time_spent_description_<%= log.id %>" name="description"
                             value="<%= log.description || '' %>" placeholder="Descriptif">
                    </div>
                  </div>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
