<% const activeSub = typeof sousTraitant !== 'undefined' ? sousTraitant : 'mario'; %>
<% let activeLabel = activeSub; %>
<% subcontractors.forEach(function(s) { if (s.id === activeSub) activeLabel = s.label; }); %>

<nav class="gestion-contrat-subnav nav nav-tabs flex-nowrap overflow-auto mb-3" aria-label="Sous-traitants">
  <% subcontractors.forEach(function(st) { %>
    <a class="nav-link <%= activeSub === st.id ? 'active' : '' %>"
       href="/events/<%= event.id %>?tab=gestion&gestion=contrat&sousTraitant=<%= st.id %>"><%= st.label %></a>
  <% }); %>
</nav>

<div class="gestion-contrat-toolbar d-flex flex-wrap align-items-center gap-2 mb-3">
  <a href="/gestion/calendrier/<%= activeSub %>?view=ententes"
     class="btn btn-sm btn-outline-secondary">Ententes par semaine</a>
  <% if (activeSub && typeof calendarShareLinks !== 'undefined' && calendarShareLinks) { %>
    <%- include('subcontractor-calendar-link', {
      subcontractorId: activeSub,
      subcontractorLabel: activeLabel,
      calendarShareLinks
    }) %>
  <% } %>
</div>

<div class="gestion-contrat-panel card border-0 bg-light">
  <div class="card-body p-3 p-md-4">
    <%- include('gestion-contrat-form', {
      event,
      contract,
      contractSaved,
      contractCleared: typeof contractCleared !== 'undefined' ? contractCleared : false,
      subcontractorId: activeSub,
      subcontractorLabel: activeLabel,
      contractSignLinks: typeof contractSignLinks !== 'undefined' ? contractSignLinks : null,
      contractSavedInDb: typeof contractSavedInDb !== 'undefined' ? contractSavedInDb : false,
      calendarShareLinks: typeof calendarShareLinks !== 'undefined' ? calendarShareLinks : null
    }) %>
  </div>
</div>
