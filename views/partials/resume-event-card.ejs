<tr id="resume-location-<%= ev.id %>" class="resume-event-row status-border-<%= ev.status %>">
  <td class="resume-event-name fw-semibold">
    <a href="/events/<%= ev.id %>" class="text-decoration-none"><%= clientShortName(ev) %></a>
  </td>
  <td><%= formatDateFr(ev.event_date) %></td>
  <td>
    <strong><%= ev.trailerNeeded ? 'Oui' : 'Non' %></strong>
  </td>
  <td>
    <% if (ev.trailerNeeded) { %>
      <strong class="<%= ev.trailerRented ? 'text-success' : 'text-warning' %>">
        <%= ev.trailerRented ? 'Oui' : 'Non' %>
      </strong>
    <% } else { %>
      <span class="text-muted">—</span>
    <% } %>
  </td>
  <td>
    <strong><%= ev.hotelNeeded ? 'Oui' : 'Non' %></strong>
  </td>
  <td>
    <% if (ev.hotelNeeded) { %>
      <strong class="<%= ev.hotelRented ? 'text-success' : 'text-warning' %>">
        <%= ev.hotelRented ? 'Oui' : 'Non' %>
      </strong>
    <% } else { %>
      <span class="text-muted">—</span>
    <% } %>
  </td>
  <td class="text-end">
    <a href="/events/<%= ev.id %>?tab=gestion&gestion=location" class="btn btn-sm btn-outline-primary">Location</a>
  </td>
</tr>
