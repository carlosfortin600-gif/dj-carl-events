<div class="resume-event-row status-border-<%= ev.status %>">
  <div class="resume-event-row-body">
    <div class="resume-event-row-line">
      <div class="resume-event-row-name">
        <div class="resume-event-row-name-text">
          <a href="/events/<%= ev.id %>" class="fw-semibold text-decoration-none"><%= clientShortName(ev) %></a>
          <div class="text-muted small"><%= ev.event_type %></div>
        </div>
        <span class="badge <%= statusBadgeClass(ev.status) %>"><%= statusLabel(ev.status) %></span>
      </div>

      <div class="resume-event-row-field">
        <span class="resume-event-row-label">Date</span>
        <span><%= formatDateFr(ev.event_date) %></span>
      </div>

      <div class="resume-event-row-field">
        <span class="resume-event-row-label">Quand</span>
        <span>
          <% if (!ev.start_time && !ev.end_time) { %>
            —
          <% } else { %>
            <% if (ev.start_time) { %><%= formatTime(ev.start_time) %><% } %>
            <% if (ev.start_time && ev.end_time) { %> à <% } %>
            <% if (ev.end_time) { %>
              <% if (ev.end_date && ev.end_date !== ev.event_date) { %>
                <%= formatDateTimeFr(ev.end_date, ev.end_time) %>
              <% } else { %>
                <%= formatTime(ev.end_time) %>
              <% } %>
            <% } %>
          <% } %>
        </span>
      </div>
    </div>

    <div class="resume-event-row-line resume-event-row-line-secondary">
      <div class="resume-event-row-field resume-event-row-where">
        <span class="resume-event-row-label">Où</span>
        <span>
          <% if (ev.address) { %>
            <span class="d-block"><%= ev.address %></span>
          <% } else if (!ev.venue) { %>
            —
          <% } %>
          <% if (ev.venue) { %>
            <span class="d-block text-muted small mt-1"><%= ev.venue %></span>
          <% } %>
        </span>

        <div class="resume-event-row-subcols mt-2">
          <div class="resume-event-row-location small">
            <span class="resume-event-row-label d-block mb-1">Location</span>
            <div class="resume-event-row-location-item">
              <span class="resume-event-row-location-type">Hôtel</span>
              <span class="resume-location-pair">
                <span>Besoin <strong><%= ev.hotelNeeded ? 'Oui' : 'Non' %></strong></span>
                <% if (ev.hotelNeeded) { %>
                  <span class="resume-location-sep" aria-hidden="true">·</span>
                  <% if (ev.hotelRented) { %>
                    <span>Loué <strong>Oui</strong></span>
                  <% } else { %>
                    <span class="resume-location-client-provided">Fournie par le client</span>
                  <% } %>
                <% } %>
              </span>
            </div>
            <div class="resume-event-row-location-item">
              <span class="resume-event-row-location-type">Trailer</span>
              <span class="resume-location-pair">
                <span>Besoin <strong><%= ev.trailerNeeded ? 'Oui' : 'Non' %></strong></span>
                <% if (ev.trailerNeeded) { %>
                  <span class="resume-location-sep" aria-hidden="true">·</span>
                  <% if (ev.trailerRented) { %>
                    <span>Loué <strong>Oui</strong></span>
                  <% } else { %>
                    <span class="resume-location-client-provided">Fournie par le client</span>
                  <% } %>
                <% } %>
              </span>
            </div>
          </div>

          <% if (ev.agreements && ev.agreements.length) { %>
            <div class="resume-event-row-ententes small">
              <span class="resume-event-row-label d-block mb-1">Ententes</span>
              <span class="resume-event-row-ententes-list">
                <% ev.agreements.forEach(function(st) { %>
                  <span class="resume-event-row-entente-item<%= st.signed ? ' resume-event-row-entente-item--signed' : '' %>">
                    <span class="resume-event-row-entente-contract">
                      <span class="resume-event-row-entente-name<%= st.signed ? ' text-success' : '' %>"><%= st.label %></span>
                      <span class="<%= st.signed ? 'text-success' : '' %>">Signé <strong><%= st.signed ? 'Oui' : 'Non' %></strong></span>
                    </span>
                    <% if (st.amount) { %>
                      <span class="resume-event-row-entente-amount<%= st.signed ? ' text-success' : '' %>"><%= st.amount %></span>
                    <% } %>
                  </span>
                <% }); %>
              </span>
            </div>
          <% } %>
        </div>
      </div>

      <div class="resume-event-row-field">
        <span class="resume-event-row-label">Prix</span>
        <span><%= ev.chargedPrice || '—' %></span>
      </div>

      <div class="resume-event-row-field resume-event-row-client small">
        <span class="resume-event-row-label">Client</span>
        <div class="resume-event-row-client-item">
          <span class="resume-event-row-client-item-label">Communication</span>
          <% const latestComm = ev.clientContactLogs && ev.clientContactLogs.length
            ? formatContactAt(ev.clientContactLogs[0].contact_date, ev.clientContactLogs[0].contact_time, ev.clientContactLogs[0].note)
            : (ev.clientCalled && ev.clientCallAt ? ev.clientCallAt : null); %>
          <% if (latestComm) { %>
            <strong class="resume-event-row-location-need-value d-block mt-1"><%= latestComm %></strong>
          <% } else { %>
            <strong class="resume-event-row-location-need-value">—</strong>
          <% } %>
        </div>
        <div class="resume-event-row-client-item">
          <span class="resume-event-row-client-item-label">Questionnaire envoyé</span>
          <% if (ev.questionnaireSent && ev.questionnaireSentAt) { %>
            <strong class="resume-event-row-location-need-value">Oui</strong>
            <span class="text-muted mx-1">·</span>
            <span>Date</span>
            <strong class="resume-event-row-location-rented-value"><%= ev.questionnaireSentAt %></strong>
          <% } else if (ev.questionnaireSent) { %>
            <strong class="resume-event-row-location-need-value">Oui</strong>
          <% } else { %>
            <strong class="resume-event-row-location-need-value">Non</strong>
          <% } %>
        </div>
        <div class="resume-event-row-client-item">
          <span class="resume-event-row-client-item-label">Rappel</span>
          <strong class="resume-event-row-location-need-value"><%= ev.callbackName || '—' %></strong>
          <% if (ev.callbackAt) { %>
            <span class="text-muted mx-1">·</span>
            <span>Date</span>
            <strong class="resume-event-row-location-rented-value"><%= ev.callbackAt %></strong>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="resume-event-row-action">
    <a href="/events/<%= ev.id %>" class="btn btn-sm btn-outline-primary">Ouvrir</a>
  </div>
</div>
