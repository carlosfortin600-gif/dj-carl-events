<div class="resume-event-row status-border-<%= ev.status %>">
  <div class="resume-event-row-body">
    <div class="resume-event-row-line">
      <div class="resume-event-row-name">
        <div class="resume-event-row-name-text">
          <a href="/events/<%= ev.id %>" class="fw-semibold text-decoration-none"><%= clientShortName(ev) %></a>
          <div class="text-muted small"><%= ev.event_type %></div>
        </div>
        <span class="badge <%= statusBadgeClass(ev.status) %>"><%= statusLabel(ev.status) %></span>
      </div>

      <div class="resume-event-row-field">
        <span class="resume-event-row-label">Date</span>
        <span><%= formatDateFr(ev.event_date) %></span>
      </div>

      <div class="resume-event-row-field">
        <span class="resume-event-row-label">Quand</span>
        <span>
          <% if (!ev.start_time && !ev.end_time) { %>
            —
          <% } else { %>
            <% if (ev.start_time) { %><%= formatTime(ev.start_time) %><% } %>
            <% if (ev.start_time && ev.end_time) { %> à <% } %>
            <% if (ev.end_time) { %>
              <% if (ev.end_date && ev.end_date !== ev.event_date) { %>
                <%= formatDateTimeFr(ev.end_date, ev.end_time) %>
              <% } else { %>
                <%= formatTime(ev.end_time) %>
              <% } %>
            <% } %>
          <% } %>
        </span>
      </div>
    </div>

    <div class="resume-event-row-line resume-event-row-line-secondary">
      <div class="resume-event-row-field resume-event-row-where">
        <span class="resume-event-row-label">Où</span>
        <span>
          <% if (ev.address) { %>
            <span class="d-block"><%= ev.address %></span>
          <% } else if (!ev.venue) { %>
            —
          <% } %>
          <% if (ev.venue) { %>
            <span class="d-block text-muted small mt-1"><%= ev.venue %></span>
          <% } %>
        </span>

        <div class="resume-event-row-subcols mt-2">
          <div class="resume-event-row-location small">
            <span class="resume-event-row-label d-block mb-1">Location</span>
            <div class="resume-event-row-location-item">
              <span class="resume-event-row-location-need-label">Hôtel — besoin</span>
              <strong class="resume-event-row-location-need-value"><%= ev.hotelNeeded ? 'Oui' : 'Non' %></strong><% if (ev.hotelNeeded) { %>
                <span class="text-muted mx-1">·</span>
                <span class="resume-event-row-location-rented-label">Loué</span>
                <strong class="resume-event-row-location-rented-value"><%= ev.hotelRented ? 'Oui' : 'Non' %></strong>
              <% } %>
            </div>
            <div class="resume-event-row-location-item">
              <span class="resume-event-row-location-need-label">Trailer — besoin</span>
              <strong class="resume-event-row-location-need-value"><%= ev.trailerNeeded ? 'Oui' : 'Non' %></strong><% if (ev.trailerNeeded) { %>
                <span class="text-muted mx-1">·</span>
                <span class="resume-event-row-location-rented-label">Loué</span>
                <strong class="resume-event-row-location-rented-value"><%= ev.trailerRented ? 'Oui' : 'Non' %></strong>
              <% } %>
            </div>
          </div>

          <% if (ev.agreements && ev.agreements.length) { %>
            <div class="resume-event-row-ententes small">
              <span class="resume-event-row-label d-block mb-1">Ententes</span>
              <span class="resume-event-row-ententes-list">
                <% ev.agreements.forEach(function(st) { %>
                  <span class="resume-event-row-entente-item">
                    <span class="resume-event-row-entente-contract">
                      <span class="resume-event-row-entente-name"><%= st.label %></span>
                      <span>Signé <strong class="<%= st.signed ? 'text-success' : '' %>"><%= st.signed ? 'Oui' : 'Non' %></strong></span>
                    </span>
                    <% if (st.amount) { %>
                      <span class="resume-event-row-entente-amount"><%= st.amount %></span>
                    <% } %>
                  </span>
                <% }); %>
              </span>
            </div>
          <% } %>
        </div>
      </div>

      <div class="resume-event-row-field">
        <span class="resume-event-row-label">Prix</span>
        <span><%= ev.chargedPrice || '—' %></span>
      </div>

      <div class="resume-event-row-field resume-event-row-client small">
        <span class="resume-event-row-label">Client</span>
        <div class="resume-event-row-location-item">
          <span class="resume-event-row-location-need-label">Contacté</span>
          <% if (ev.clientContactLogs && ev.clientContactLogs.length) { %>
            <strong class="resume-event-row-location-need-value"><%= ev.clientContactLogs.length %> comm.<%= ev.clientContactLogs.length !== 1 ? 's' : '' %></strong>
            <span class="d-block text-muted small mt-1">
              <% ev.clientContactLogs.forEach(function(log, i) { %>
                <%= formatContactAt(log.contact_date, log.contact_time, log.note) %><%= i < ev.clientContactLogs.length - 1 ? ' · ' : '' %>
              <% }); %>
            </span>
          <% } else { %>
            <strong class="resume-event-row-location-need-value"><%= ev.clientCalled ? 'Oui' : 'Non' %></strong>
            <% if (ev.clientCalled && ev.clientCallAt) { %>
              <span class="text-muted mx-1">·</span>
              <span>Date</span>
              <strong class="resume-event-row-location-rented-value"><%= ev.clientCallAt %></strong>
            <% } %>
          <% } %>
        </div>
        <div class="resume-event-row-location-item mt-1">
          <span class="resume-event-row-location-need-label">E-mail RDV</span>
          <% if (ev.emailRdvSentLogs && ev.emailRdvSentLogs.length) { %>
            <strong class="resume-event-row-location-need-value"><%= ev.emailRdvSentLogs.length %> envoi<%= ev.emailRdvSentLogs.length !== 1 ? 's' : '' %></strong>
            <span class="d-block text-muted small mt-1">
              <% ev.emailRdvSentLogs.forEach(function(log, i) { %>
                <%= formatDateTimeFr(log.sent_date, log.sent_time) %><%= i < ev.emailRdvSentLogs.length - 1 ? ' · ' : '' %>
              <% }); %>
            </span>
          <% } else { %>
            <strong class="resume-event-row-location-need-value"><%= ev.emailRdvSent ? 'Oui' : 'Non' %></strong>
            <% if (ev.emailRdvSent && ev.emailRdvAt) { %>
              <span class="text-muted mx-1">·</span>
              <span>Date</span>
              <strong class="resume-event-row-location-rented-value"><%= ev.emailRdvAt %></strong>
            <% } %>
          <% } %>
        </div>
        <div class="resume-event-row-location-item mt-1">
          <span class="resume-event-row-location-need-label">Rappel</span>
          <strong class="resume-event-row-location-need-value"><%= ev.callbackName || '—' %></strong>
          <% if (ev.callbackAt) { %>
            <span class="text-muted mx-1">·</span>
            <span>Date</span>
            <strong class="resume-event-row-location-rented-value"><%= ev.callbackAt %></strong>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="resume-event-row-action">
    <a href="/events/<%= ev.id %>" class="btn btn-sm btn-outline-primary">Ouvrir</a>
  </div>
</div>
