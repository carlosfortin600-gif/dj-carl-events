<div class="resume-event-row status-border-<%= ev.status %>">
  <div class="resume-event-row-main">
    <div class="resume-event-row-name">
      <a href="/events/<%= ev.id %>" class="fw-semibold text-decoration-none"><%= clientShortName(ev) %></a>
      <span class="badge <%= statusBadgeClass(ev.status) %>"><%= statusLabel(ev.status) %></span>
    </div>

    <div class="resume-event-row-field">
      <span class="resume-event-row-label">Date</span>
      <span><%= formatDateFr(ev.event_date) %></span>
    </div>

    <div class="resume-event-row-field">
      <span class="resume-event-row-label">Quand</span>
      <span><%= ev.start_time ? formatTime(ev.start_time) : '—' %></span>
    </div>

    <div class="resume-event-row-field resume-event-row-venue">
      <span class="resume-event-row-label">Où</span>
      <span><%= ev.venue || '—' %></span>
    </div>

    <div class="resume-event-row-field">
      <span class="resume-event-row-label">Prix</span>
      <span><%= ev.chargedPrice || '—' %></span>
    </div>

    <% if (ev.agreements && ev.agreements.length) { %>
      <div class="resume-event-row-field resume-event-row-ententes">
        <span class="resume-event-row-label">Ententes</span>
        <span class="small">
          <% ev.agreements.forEach(function(st, idx) { %>
            <% if (idx > 0) { %><span class="text-muted mx-1">·</span><% } %>
            <%= st.label %> — Signé <strong class="<%= st.signed ? 'text-success' : '' %>"><%= st.signed ? 'Oui' : 'Non' %></strong>
          <% }); %>
        </span>
      </div>
    <% } %>

    <div class="resume-event-row-field resume-event-row-location">
      <span class="resume-event-row-label">Location</span>
      <span class="small">
        Hôtel <strong><%= ev.hotelNeeded ? 'Oui' : 'Non' %></strong><% if (ev.hotelNeeded) { %> · Loué <strong><%= ev.hotelRented ? 'Oui' : 'Non' %></strong><% } %>
        <span class="text-muted mx-1">·</span>
        Trailer <strong><%= ev.trailerNeeded ? 'Oui' : 'Non' %></strong><% if (ev.trailerNeeded) { %> · Loué <strong><%= ev.trailerRented ? 'Oui' : 'Non' %></strong><% } %>
      </span>
    </div>
  </div>

  <div class="resume-event-row-action">
    <a href="/events/<%= ev.id %>" class="btn btn-sm btn-outline-primary">Ouvrir</a>
  </div>
</div>
