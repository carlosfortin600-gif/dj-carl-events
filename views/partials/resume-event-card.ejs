<div class="resume-event-row status-border-<%= ev.status %>">
  <div class="resume-event-row-body">
    <div class="resume-event-row-line">
      <div class="resume-event-row-name">
        <div class="resume-event-row-name-text">
          <a href="/events/<%= ev.id %>" class="fw-semibold text-decoration-none"><%= clientShortName(ev) %></a>
          <div class="text-muted small"><%= ev.event_type %></div>
        </div>
        <span class="badge <%= statusBadgeClass(ev.status) %>"><%= statusLabel(ev.status) %></span>
      </div>

      <div class="resume-event-row-field">
        <span class="resume-event-row-label">Date</span>
        <span><%= formatDateFr(ev.event_date) %></span>
      </div>

      <div class="resume-event-row-field">
        <span class="resume-event-row-label">Quand</span>
        <span><%= ev.start_time ? formatTime(ev.start_time) : '—' %></span>
      </div>
    </div>

    <div class="resume-event-row-line resume-event-row-line-secondary">
      <div class="resume-event-row-field resume-event-row-where">
        <span class="resume-event-row-label">Où</span>
        <span><%= ev.venue || '—' %></span>

        <div class="resume-event-row-subcols mt-2">
          <div class="resume-event-row-location small">
            <span class="resume-event-row-label d-block mb-1">Location</span>
            <div class="resume-event-row-location-item">
              Hôtel — besoin <strong><%= ev.hotelNeeded ? 'Oui' : 'Non' %></strong><% if (ev.hotelNeeded) { %>
                · Loué <strong><%= ev.hotelRented ? 'Oui' : 'Non' %></strong>
              <% } %>
            </div>
            <div class="resume-event-row-location-item">
              Trailer — besoin <strong><%= ev.trailerNeeded ? 'Oui' : 'Non' %></strong><% if (ev.trailerNeeded) { %>
                · Loué <strong><%= ev.trailerRented ? 'Oui' : 'Non' %></strong>
              <% } %>
            </div>
          </div>

          <% if (ev.agreements && ev.agreements.length) { %>
            <div class="resume-event-row-ententes small">
              <span class="resume-event-row-label d-block mb-1">Ententes</span>
              <span class="resume-event-row-ententes-list">
                <% ev.agreements.forEach(function(st) { %>
                  <span class="resume-event-row-entente-item">
                    <span class="resume-event-row-entente-contract">
                      <span class="resume-event-row-entente-name"><%= st.label %></span>
                      <span>Signé <strong class="<%= st.signed ? 'text-success' : '' %>"><%= st.signed ? 'Oui' : 'Non' %></strong></span>
                    </span>
                    <% if (st.amount) { %>
                      <span class="resume-event-row-entente-amount"><%= st.amount %></span>
                    <% } %>
                  </span>
                <% }); %>
              </span>
            </div>
          <% } %>
        </div>
      </div>

      <div class="resume-event-row-field">
        <span class="resume-event-row-label">Prix</span>
        <span><%= ev.chargedPrice || '—' %></span>
      </div>
    </div>
  </div>

  <div class="resume-event-row-action">
    <a href="/events/<%= ev.id %>" class="btn btn-sm btn-outline-primary">Ouvrir</a>
  </div>
</div>
