<% const weeks = typeof upcomingByWeek !== 'undefined' ? upcomingByWeek : (typeof eventsByWeek !== 'undefined' ? eventsByWeek : []); %>
<% const weekRowType = typeof rowType !== 'undefined' ? rowType : 'dashboard'; %>

<% if (!weeks.length) { %>
  <div class="upcoming-by-month-empty text-muted py-4 text-center">
    <%= typeof emptyMessage !== 'undefined' ? emptyMessage : 'Aucun événement à venir' %>
  </div>
<% } else { %>
  <div class="upcoming-by-month upcoming-by-week">
    <% weeks.forEach(function(week) { %>
      <section class="upcoming-month-block mb-4<%= week.isCurrentWeek ? ' upcoming-month-block--current' : '' %><%= week.isNextWeek ? ' upcoming-month-block--next' : '' %>">
        <header class="upcoming-month-header">
          <div class="upcoming-month-header-text">
            <h3 class="upcoming-month-title mb-0">
              <%= week.headingWithTotal || week.heading %>
            </h3>
            <% if (week.isCurrentWeek || week.isNextWeek) { %>
              <p class="upcoming-month-subtitle mb-0"><%= week.weekLabel %></p>
            <% } else { %>
              <p class="upcoming-month-subtitle mb-0 text-muted"><%= week.weekLabel %></p>
            <% } %>
          </div>
          <span class="badge upcoming-month-count"><%= week.eventCount %> événement<%= week.eventCount !== 1 ? 's' : '' %></span>
        </header>
        <% if (weekRowType === 'logistique' && typeof logisticsEmailRecipients !== 'undefined') { %>
          <div class="logistique-week-send-bar px-3 py-2 border-bottom bg-white">
            <%- include('logistique-week-send', {
              weekStart: week.weekStart,
              recipients: logisticsEmailRecipients,
              emailConfigured: typeof logisticsEmailConfigured !== 'undefined' ? logisticsEmailConfigured : false
            }) %>
          </div>
        <% } %>
        <div class="upcoming-month-events <%= (weekRowType === 'resume' || weekRowType === 'logistique') ? 'resume-events-list' : 'list-group list-group-flush' %>">
          <% week.events.forEach(function(ev) { %>
            <% if (weekRowType === 'resume') { %>
              <%- include('resume-event-card', { ev }) %>
            <% } else if (weekRowType === 'logistique') { %>
              <%- include('logistique-event-card', { ev }) %>
            <% } else { %>
              <%- include('upcoming-event-row', { ev }) %>
            <% } %>
          <% }); %>
        </div>
      </section>
    <% }); %>
  </div>
<% } %>