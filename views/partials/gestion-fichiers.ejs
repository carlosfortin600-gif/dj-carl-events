<section class="form-section form-section-gestion mb-4">
  <h2 class="form-section-title">Téléverser des fichiers</h2>
  <p class="text-muted small mb-3">
    Contrats, plans, listes, photos, audio… (max <%= formatFileSize(maxFileSize) %> par fichier, jusqu'à <%= maxFilesPerUpload %> à la fois)
  </p>
  <form method="post" action="/events/<%= event.id %>/files/upload" enctype="multipart/form-data" class="card bg-light">
    <div class="card-body">
      <div class="mb-3">
        <label class="form-label" for="gestion_files">Fichiers</label>
        <input type="file" class="form-control" id="gestion_files" name="files" multiple required>
      </div>
      <button type="submit" class="btn btn-primary">Téléverser</button>
    </div>
  </form>
</section>

<section class="form-section form-section-gestion">
  <h2 class="form-section-title">Fichiers du dossier</h2>
  <% if (!eventFiles.length) { %>
    <p class="text-muted mb-0">Aucun fichier pour cet événement.</p>
  <% } else { %>
    <div class="event-files-list">
      <% eventFiles.forEach(function(file) {
        const viewUrl = '/events/' + event.id + '/files/' + file.id + '/view';
        const downloadUrl = '/events/' + event.id + '/files/' + file.id + '/download';
        const mime = file.mime_type || '';
        const name = file.original_name || '';
        const isImage = mime.startsWith('image/') || /\.(jpe?g|png|gif|webp|svg)$/i.test(name);
        const isPdf = mime === 'application/pdf' || /\.pdf$/i.test(name);
        const isAudio = mime.startsWith('audio/') || /\.(mp3|wav|m4a)$/i.test(name);
        const isVideo = mime.startsWith('video/') || /\.(mp4|webm)$/i.test(name);
        const isText = mime.startsWith('text/') || /\.(txt|csv)$/i.test(name);
        const canPreview = isImage || isPdf || isAudio || isVideo || isText;
      %>
        <article class="event-file-card card mb-3">
          <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
              <div class="min-w-0">
                <strong class="text-break"><%= file.original_name %></strong>
                <div class="small text-muted">
                  <%= formatFileSize(file.size_bytes) %>
                  <% if (file.uploaded_at) { %> · <%= formatTimestampFr(file.uploaded_at) %><% } %>
                </div>
              </div>
              <div class="d-flex gap-2 flex-shrink-0">
                <a href="<%= viewUrl %>" target="_blank" rel="noopener" class="btn btn-sm btn-primary">Ouvrir</a>
                <a href="<%= downloadUrl %>" class="btn btn-sm btn-outline-secondary">Télécharger</a>
                <form method="post" action="/events/<%= event.id %>/files/<%= file.id %>/delete" class="d-inline">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                </form>
              </div>
            </div>

            <% if (canPreview) { %>
              <div class="event-file-preview mt-2">
                <% if (isImage) { %>
                  <a href="<%= viewUrl %>" target="_blank" rel="noopener" class="event-file-preview-link d-inline-block">
                    <img src="<%= viewUrl %>" alt="" class="event-file-preview-img img-fluid rounded border" loading="lazy">
                  </a>
                <% } else if (isPdf) { %>
                  <iframe src="<%= viewUrl %>" class="event-file-preview-pdf rounded border" title="Aperçu PDF — <%= file.original_name %>"></iframe>
                <% } else if (isAudio) { %>
                  <audio controls class="w-100 event-file-preview-audio" src="<%= viewUrl %>"></audio>
                <% } else if (isVideo) { %>
                  <video controls class="w-100 rounded border event-file-preview-video" src="<%= viewUrl %>"></video>
                <% } else if (isText) { %>
                  <iframe src="<%= viewUrl %>" class="event-file-preview-text rounded border" title="Aperçu — <%= file.original_name %>"></iframe>
                <% } %>
              </div>
            <% } else { %>
              <p class="small text-muted mb-0 mt-1">Aperçu non disponible — utilisez <strong>Ouvrir</strong> ou <strong>Télécharger</strong>.</p>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>
  <% } %>
</section>
