<% function gestionDepartUrl(id) { return '/events/' + id + '?tab=gestion&gestion=depart'; } %>
<% function gestionLocationUrl(id) { return '/events/' + id + '?tab=gestion&gestion=location'; } %>
<% const salleAddress = [ev.address, ev.city].filter(function (p) { return p && String(p).trim(); }).join(', '); %>
<% const directionsUrl = ev.departureFrom && ev.arrivalAddress
  ? googleMapsDirectionsUrl(ev.departureFrom, ev.arrivalAddress) : null; %>

<div class="resume-event-row logistique-event-row status-border-<%= ev.status %>">
  <div class="resume-event-row-body">
    <div class="resume-event-row-line">
      <div class="resume-event-row-name flex-grow-1">
        <div class="resume-event-row-name-text w-100">
          <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
            <a href="/events/<%= ev.id %>" class="fw-semibold text-decoration-none"><%= clientShortName(ev) %></a>
            <span class="badge <%= statusBadgeClass(ev.status) %>"><%= statusLabel(ev.status) %></span>
          </div>

          <div class="logistique-client-times mt-2">
            <div class="logistique-leg">
              <div class="logistique-leg-head">
                <span class="resume-event-row-label">Départ</span>
                <span class="logistics-time fw-semibold text-primary"><%= ev.departureTimeLabel || '—' %></span>
                <% if (ev.departureDateLabel) { %>
                  <span class="small text-muted">· <%= ev.departureDateLabel %></span>
                <% } %>
              </div>
              <% if (ev.departureFrom) { %>
                <div class="small text-muted mt-1">
                  de <%- include('maps-link', { address: ev.departureFrom, linkClass: 'logistique-address-link' }) %>
                </div>
              <% } %>
            </div>
            <div class="logistique-leg">
              <div class="logistique-leg-head">
                <span class="resume-event-row-label">Arrivée</span>
                <span class="logistics-time fw-semibold text-primary"><%= ev.arrivalTimeLabel || '—' %></span>
                <% if (ev.arrivalDateLabel) { %>
                  <span class="small text-muted">· <%= ev.arrivalDateLabel %></span>
                <% } %>
              </div>
              <% if (ev.arrivalAddress) { %>
                <div class="small text-muted mt-1">
                  à <%- include('maps-link', { address: ev.arrivalAddress, linkClass: 'logistique-address-link' }) %>
                </div>
              <% } %>
            </div>
          </div>

          <% if (directionsUrl) { %>
            <a href="<%= directionsUrl %>" target="_blank" rel="noopener noreferrer"
               class="small d-inline-block mt-2">Itinéraire Google Maps</a>
          <% } %>

          <div class="text-muted small mt-2">
            <%= ev.event_type %> · <%= formatDateFr(ev.event_date) %>
            <% if (ev.venue) { %>
              · <%- include('maps-link', { address: ev.venue, linkClass: 'maps-address-link text-muted' }) %>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="resume-event-row-line resume-event-row-line-secondary">
      <div class="resume-event-row-field resume-event-row-where">
        <span class="resume-event-row-label">Salle</span>
        <span>
          <% if (salleAddress) { %>
            <span class="d-block">
              <%- include('maps-link', { address: salleAddress }) %>
            </span>
          <% } else if (!ev.venue) { %>
            —
          <% } %>
          <% if (ev.venue && salleAddress) { %>
            <span class="d-block text-muted small mt-1">
              <%- include('maps-link', { address: ev.venue, linkClass: 'maps-address-link text-muted' }) %>
            </span>
          <% } else if (ev.venue && !salleAddress) { %>
            <span class="d-block"><%- include('maps-link', { address: ev.venue }) %></span>
          <% } %>
        </span>

        <div class="resume-event-row-gestion small mt-2">
          <span class="resume-event-row-label d-block mb-1">Accès</span>
          <% if (ev.accessSummary) { %>
            <div class="text-muted"><%= ev.accessSummary %></div>
          <% } else { %>
            <div class="text-muted">—</div>
          <% } %>

          <div class="mt-2 pt-2">
            <div class="resume-event-row-location-item">
              <span class="resume-event-row-location-type">Hôtel</span>
              <span class="resume-location-pair">
                <% if (ev.hotelPeriod && ev.hotelPeriod !== '—') { %>
                  <span><%= ev.hotelPeriod %></span>
                  <% if (ev.hotelLocation) { %>
                    <span class="resume-location-sep" aria-hidden="true">·</span>
                    <%- include('maps-link', { address: ev.hotelLocation }) %>
                  <% } %>
                  <% if (ev.hotelEventDistance) { %>
                    <span class="resume-location-sep" aria-hidden="true">·</span>
                    <span>Hôtel ↔ salle : <%= ev.hotelEventDistance %></span>
                  <% } %>
                <% } else { %>
                  <span>Besoin <strong><%= ev.hotelNeeded ? 'Oui' : 'Non' %></strong></span>
                <% } %>
              </span>
            </div>
            <div class="resume-event-row-location-item">
              <span class="resume-event-row-location-type">Trailer</span>
              <span class="resume-location-pair">
                <% if (ev.trailerPeriod && ev.trailerPeriod !== '—') { %>
                  <span><%= ev.trailerPeriod %></span>
                  <% if (ev.trailerLocation) { %>
                    <span class="resume-location-sep" aria-hidden="true">·</span>
                    <%- include('maps-link', { address: ev.trailerLocation }) %>
                  <% } %>
                <% } else { %>
                  <span>Besoin <strong><%= ev.trailerNeeded ? 'Oui' : 'Non' %></strong></span>
                <% } %>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="resume-event-row-action d-flex flex-column gap-1">
    <a href="<%= gestionDepartUrl(ev.id) %>" class="btn btn-sm btn-primary">Gestion départ</a>
    <a href="<%= gestionLocationUrl(ev.id) %>" class="btn btn-sm btn-outline-secondary">Location</a>
  </div>
</div>