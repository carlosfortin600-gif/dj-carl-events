<% if (timelineSaved) { %>
  <div class="alert alert-success">Plan de soirée enregistré.</div>
<% } %>
<% if (timelineGenerated) { %>
  <div class="alert <%= timelineGeneratedMessage && timelineGeneratedMessage.includes('Aucune') ? 'alert-warning' : 'alert-success' %>"><%= timelineGeneratedMessage %></div>
<% } %>
<% if (timelineNeedsConfirm) { %>
  <div class="alert alert-warning">
    <%= timelineExistingCount %> étape(s) existent déjà. Voulez-vous ajouter les étapes du questionnaire sans effacer les étapes manuelles ?
    <form method="post" action="/events/<%= event.id %>/timeline/generate" class="d-inline ms-2">
      <input type="hidden" name="confirm" value="1">
      <button type="submit" class="btn btn-sm btn-warning">Oui, ajouter les étapes</button>
    </form>
  </div>
<% } %>

<div class="card mb-4 <%= proposedTimelineSteps.length ? 'border-info' : 'border-warning' %>">
  <div class="card-body py-3">
    <h3 class="h6 mb-2">Aperçu depuis le questionnaire enregistré</h3>
    <% if (!questionnaire || !questionnaire.updated_at) { %>
      <p class="text-muted small mb-0">
        Le questionnaire n'a pas encore été enregistré. Remplissez l'onglet <strong>Questionnaire</strong>, cliquez sur
        <strong>Enregistrer le questionnaire</strong>, puis revenez ici.
      </p>
    <% } else if (proposedTimelineSteps.length === 0) { %>
      <p class="text-muted small mb-0">
        Aucune heure ou moment repéré. Ajoutez au minimum les heures dans
        <strong>Informations générales</strong> (entrée, souper, party…) ou cochez des moments importants, puis enregistrez le questionnaire.
      </p>
    <% } else { %>
      <p class="text-muted small mb-2"><%= proposedTimelineSteps.length %> étape(s) prête(s) à être générée(s) :</p>
      <ul class="small mb-0 ps-3">
        <% proposedTimelineSteps.forEach(function(step) { %>
          <li>
            <strong><%= step.time ? formatTime(step.time) : '—' %></strong>
            — <%= step.title %>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</div>

<% const clientPlanSteps = (questionnaire && questionnaire.data && questionnaire.data.client_plan && questionnaire.data.client_plan.steps) ? questionnaire.data.client_plan.steps : []; %>
<% if (clientPlanSteps.length) { %>
  <div class="card mb-4 border-primary">
    <div class="card-body py-3">
      <h3 class="h6 mb-2">Plan proposé par le client</h3>
      <ul class="small mb-0 ps-3">
        <% clientPlanSteps.forEach(function(step) { %>
          <li>
            <strong><%= step.time ? formatTime(step.time) : '—' %></strong>
            — <%= step.title %>
            <% if (step.description) { %><span class="text-muted"> · <%= step.description %></span><% } %>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>
<% } %>

<div class="d-flex flex-wrap gap-2 mb-4">
  <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#addTimelineForm">
    + Ajouter une étape
  </button>
  <form method="post" action="/events/<%= event.id %>/timeline/generate" class="d-inline">
    <button type="submit" class="btn btn-outline-primary">Générer à partir du questionnaire</button>
  </form>
</div>

<p class="text-muted small mb-4">
  Génération automatique : entrée des invités, souper, première danse, ouverture du plancher, cocktail, discours et moments cochés dans le questionnaire.
  Les heures du questionnaire sont reprises quand elles sont indiquées.
</p>

<div class="collapse mb-4" id="addTimelineForm">
  <div class="card bg-light">
    <div class="card-body">
      <h3 class="h6 mb-3">Nouvelle étape</h3>
      <form method="post" action="/events/<%= event.id %>/timeline/add" data-unsaved-guard>
        <div class="row g-2">
          <div class="col-md-2">
            <label class="form-label small">Heure</label>
            <input type="time" class="form-control form-control-sm" name="time">
          </div>
          <div class="col-md-4">
            <label class="form-label small">Titre *</label>
            <input type="text" class="form-control form-control-sm" name="title" required>
          </div>
          <div class="col-md-3">
            <label class="form-label small">Artiste</label>
            <input type="text" class="form-control form-control-sm" name="song_artist">
          </div>
          <div class="col-md-3">
            <label class="form-label small">Chanson</label>
            <input type="text" class="form-control form-control-sm" name="song_title">
          </div>
          <div class="col-md-6">
            <label class="form-label small">Description</label>
            <input type="text" class="form-control form-control-sm" name="description">
          </div>
          <div class="col-md-6">
            <label class="form-label small">Notes DJ</label>
            <input type="text" class="form-control form-control-sm" name="dj_notes">
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-sm mt-3">Ajouter</button>
      </form>
    </div>
  </div>
</div>

<% if (timelineItems.length === 0) { %>
  <p class="text-muted text-center py-4">Aucune étape. Ajoutez-en manuellement ou générez à partir du questionnaire.</p>
<% } else { %>
  <div class="timeline-list">
    <% timelineItems.forEach(function(item, index) { %>
      <div class="timeline-item card mb-3">
        <div class="card-body p-3">
          <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
            <div>
              <span class="timeline-time badge bg-dark me-2"><%= item.time ? formatTime(item.time) : '—' %></span>
              <strong><%= item.title %></strong>
            </div>
            <div class="btn-group btn-group-sm">
              <form method="post" action="/events/<%= event.id %>/timeline/<%= item.id %>/move-up" class="d-inline">
                <button type="submit" class="btn btn-outline-secondary" <%= index === 0 ? 'disabled' : '' %> title="Monter">↑</button>
              </form>
              <form method="post" action="/events/<%= event.id %>/timeline/<%= item.id %>/move-down" class="d-inline">
                <button type="submit" class="btn btn-outline-secondary" <%= index === timelineItems.length - 1 ? 'disabled' : '' %> title="Descendre">↓</button>
              </form>
              <button type="button" class="btn btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#editItem<%= item.id %>">Modifier</button>
              <form method="post" action="/events/<%= event.id %>/timeline/<%= item.id %>/delete" class="d-inline"
                    onsubmit="return confirm('Supprimer cette étape ?');">
                <button type="submit" class="btn btn-outline-danger">Supprimer</button>
              </form>
            </div>
          </div>
          <% if (item.description) { %><p class="small mb-1 text-muted"><%= item.description %></p><% } %>
          <% if (item.song_artist || item.song_title) { %>
            <p class="small mb-1"><span class="text-muted">Chanson :</span> <%= [item.song_artist, item.song_title].filter(Boolean).join(' — ') %></p>
          <% } %>
          <% if (item.dj_notes) { %><p class="small mb-0 text-info"><span class="text-muted">Notes DJ :</span> <%= item.dj_notes %></p><% } %>

          <div class="collapse mt-3" id="editItem<%= item.id %>">
            <form method="post" action="/events/<%= event.id %>/timeline/<%= item.id %>/update" data-unsaved-guard>
              <div class="row g-2">
                <div class="col-md-2">
                  <input type="time" class="form-control form-control-sm" name="time" value="<%= item.time || '' %>">
                </div>
                <div class="col-md-4">
                  <input type="text" class="form-control form-control-sm" name="title" value="<%= item.title %>" required>
                </div>
                <div class="col-md-3">
                  <input type="text" class="form-control form-control-sm" name="song_artist" value="<%= item.song_artist || '' %>" placeholder="Artiste">
                </div>
                <div class="col-md-3">
                  <input type="text" class="form-control form-control-sm" name="song_title" value="<%= item.song_title || '' %>" placeholder="Chanson">
                </div>
                <div class="col-md-6">
                  <input type="text" class="form-control form-control-sm" name="description" value="<%= item.description || '' %>" placeholder="Description">
                </div>
                <div class="col-md-6">
                  <input type="text" class="form-control form-control-sm" name="dj_notes" value="<%= item.dj_notes || '' %>" placeholder="Notes DJ">
                </div>
              </div>
              <button type="submit" class="btn btn-primary btn-sm mt-2">Enregistrer</button>
            </form>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>
