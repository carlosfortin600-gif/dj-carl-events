<% function dayUrl(dateStr) {
  const q = queryString({ view: 'day', date: dateStr });
  return calendarBasePath + '?' + q;
} %>

<div class="row g-2">
  <% weekDays.forEach(function(day) { %>
    <div class="col-12 col-md-6 col-lg">
      <div class="card h-100 <%= day.isToday ? 'border-primary' : '' %>">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
          <span class="small fw-semibold"><%= day.weekdayLabel %> <%= day.dayNum %></span>
          <a href="<%= dayUrl(day.iso) %>" class="btn btn-link btn-sm p-0">Jour</a>
        </div>
        <div class="card-body py-2">
          <% if (!day.items.length) { %>
            <p class="text-muted small mb-0">—</p>
          <% } else { %>
            <ul class="list-unstyled small mb-0">
              <% day.items.forEach(function(item) { %>
                <li class="mb-2 logistics-kind-<%= item.kind %>">
                  <strong><%= item.clientLabel %></strong> — <%= item.label %>
                  <% if (item.when && item.when !== '—') { %><div class="text-muted"><%= item.when %></div><% } %>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      </div>
    </div>
  <% }); %>
</div>