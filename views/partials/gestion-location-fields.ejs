<% 
  const trailerNeeded = djNotes.tech_trailer_needed
    || ((djNotes.tech_trailer_start || djNotes.tech_trailer_end) ? 'yes' : 'no');
  const roomNeeded = djNotes.tech_room_needed
    || ((djNotes.tech_room_location || djNotes.tech_room_start || djNotes.tech_room_end) ? 'yes' : 'no');
%>

<section class="form-section form-section-technique-trailer mb-4">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h2 class="form-section-title mb-0">Location trailer</h2>
    <div class="btn-group btn-group-sm" role="group" aria-label="Location trailer requise">
      <input type="radio" class="btn-check" name="tech_trailer_needed" id="tech_trailer_yes" value="yes"
             <%= trailerNeeded === 'yes' ? 'checked' : '' %>>
      <label class="btn btn-outline-secondary" for="tech_trailer_yes">Oui</label>
      <input type="radio" class="btn-check" name="tech_trailer_needed" id="tech_trailer_no" value="no"
             <%= trailerNeeded === 'no' ? 'checked' : '' %>>
      <label class="btn btn-outline-secondary" for="tech_trailer_no">Non</label>
    </div>
  </div>
  <div id="tech_trailer_fields" class="row g-3" <%= trailerNeeded === 'no' ? 'hidden' : '' %>>
    <div class="col-md-6">
      <label class="form-label" for="tech_trailer_start_datetime">Du — date et heure</label>
      <%- include('datetime-fr-field', {
        id: 'tech_trailer_start_datetime',
        name: 'tech_trailer_start_datetime',
        value: endDatetimeLocalValue(event.event_date, djNotes.tech_trailer_start, djNotes.tech_trailer_start_time),
        displayValue: djNotes.tech_trailer_start
          ? formatDateTimeFr(djNotes.tech_trailer_start, djNotes.tech_trailer_start_time) : ''
      }) %>
    </div>
    <div class="col-md-6">
      <label class="form-label" for="tech_trailer_end_datetime">Au — date et heure</label>
      <%- include('datetime-fr-field', {
        id: 'tech_trailer_end_datetime',
        name: 'tech_trailer_end_datetime',
        value: endDatetimeLocalValue(event.event_date, djNotes.tech_trailer_end, djNotes.tech_trailer_end_time),
        displayValue: djNotes.tech_trailer_end
          ? formatDateTimeFr(djNotes.tech_trailer_end, djNotes.tech_trailer_end_time) : ''
      }) %>
    </div>
  </div>
</section>

<section class="form-section form-section-technique-room mb-4">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h2 class="form-section-title mb-0">Location chambre</h2>
    <div class="btn-group btn-group-sm" role="group" aria-label="Location chambre requise">
      <input type="radio" class="btn-check" name="tech_room_needed" id="tech_room_yes" value="yes"
             <%= roomNeeded === 'yes' ? 'checked' : '' %>>
      <label class="btn btn-outline-secondary" for="tech_room_yes">Oui</label>
      <input type="radio" class="btn-check" name="tech_room_needed" id="tech_room_no" value="no"
             <%= roomNeeded === 'no' ? 'checked' : '' %>>
      <label class="btn btn-outline-secondary" for="tech_room_no">Non</label>
    </div>
  </div>
  <div id="tech_room_fields" class="row g-3" <%= roomNeeded === 'no' ? 'hidden' : '' %>>
    <div class="col-12">
      <label class="form-label" for="tech_room_location">Endroit</label>
      <input type="text" class="form-control" id="tech_room_location" name="tech_room_location"
             value="<%= djNotes.tech_room_location || '' %>"
             placeholder="Nom ou adresse de la chambre"
             <%= roomNeeded === 'no' ? 'disabled' : '' %>>
    </div>
    <div class="col-md-6">
      <label class="form-label" for="tech_room_start_datetime">Du — date et heure</label>
      <%- include('datetime-fr-field', {
        id: 'tech_room_start_datetime',
        name: 'tech_room_start_datetime',
        value: endDatetimeLocalValue(event.event_date, djNotes.tech_room_start, djNotes.tech_room_start_time),
        displayValue: djNotes.tech_room_start
          ? formatDateTimeFr(djNotes.tech_room_start, djNotes.tech_room_start_time) : ''
      }) %>
    </div>
    <div class="col-md-6">
      <label class="form-label" for="tech_room_end_datetime">Au — date et heure</label>
      <%- include('datetime-fr-field', {
        id: 'tech_room_end_datetime',
        name: 'tech_room_end_datetime',
        value: endDatetimeLocalValue(event.event_date, djNotes.tech_room_end, djNotes.tech_room_end_time),
        displayValue: djNotes.tech_room_end
          ? formatDateTimeFr(djNotes.tech_room_end, djNotes.tech_room_end_time) : ''
      }) %>
    </div>
  </div>
</section>
