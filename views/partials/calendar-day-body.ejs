<% 
  const hasEvents = dayEvents && dayEvents.length;
%>

<% if (hasEvents) { %>
  <h3 class="h6 text-uppercase text-muted mb-3">Événements</h3>
  <div class="calendar-events-stack mb-4">
    <% dayEvents.forEach(function(ev) { %>
      <div class="calendar-event-card calendar-day-event status-border-<%= ev.status %>">
        <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
          <div>
            <strong><%= clientShortName(ev) %></strong>
            <div class="text-muted small">
              <%= ev.event_type %>
              <% if (ev.calendarTime || ev.start_time) { %> · <%= formatTime(ev.calendarTime || ev.start_time) %><% } %>
              <% if (ev.venue) { %> · <%= ev.venue %><% } %>
            </div>
            <%- include('calendar-agreement-summary', { ev, showAgreementSummary: typeof showAgreementSummary !== 'undefined' ? showAgreementSummary : false }) %>
            <div class="d-flex gap-2 mt-2 flex-wrap">
              <%- include('calendar-contract-btn', {
                ev,
                subcontractorLabel: typeof subcontractorLabel !== 'undefined' ? subcontractorLabel : '',
                showContractLink: typeof showContractLink !== 'undefined' ? showContractLink : false,
                showAgreementSummary: typeof showAgreementSummary !== 'undefined' ? showAgreementSummary : false,
                publicCalendarMode: typeof publicCalendarMode !== 'undefined' ? publicCalendarMode : false
              }) %>
            </div>
          </div>
          <span class="badge <%= statusBadgeClass(ev.status) %>"><%= statusLabel(ev.status) %></span>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<% if (showDayGestionDetails && dayGestionDetails) { %>
  <%- include('calendar-gestion-blocks', { gestionDetails: dayGestionDetails, compact: false }) %>
<% } %>

<% if (!hasEvents && !(showDayGestionDetails && dayGestionDetails)) { %>
  <p class="text-muted text-center py-4 mb-0">Rien de planifié ce jour-là.</p>
<% } %>
