<% const selected = typeof selectedServices !== 'undefined' ? selectedServices : []; %>
<% const customSlots = typeof customServiceSlots !== 'undefined'
  ? customServiceSlots
  : Array.from({ length: CUSTOM_SERVICE_SLOT_COUNT }, () => ({ enabled: false, name: '' })); %>
<% const baseOptions = typeof baseServiceOptions !== 'undefined'
  ? baseServiceOptions
  : (typeof BASE_SERVICE_OPTIONS !== 'undefined' ? BASE_SERVICE_OPTIONS : SERVICE_OPTIONS); %>
<% const addonOptions = typeof addonServiceOptions !== 'undefined'
  ? addonServiceOptions
  : (typeof ADDON_SERVICE_OPTIONS !== 'undefined' ? ADDON_SERVICE_OPTIONS : []); %>
<% const supplementaryOptions = typeof supplementaryServiceOptions !== 'undefined'
  ? supplementaryServiceOptions
  : (typeof SUPPLEMENTARY_SERVICE_OPTIONS !== 'undefined' ? SUPPLEMENTARY_SERVICE_OPTIONS : []); %>

<% const animationIncluded = typeof animationIncludedValue !== 'undefined'
  ? (animationIncludedValue || '')
  : (selected.includes('Animation') ? 'yes' : ''); %>
<% const animationNotes = typeof animationNotesValue !== 'undefined' ? (animationNotesValue || '') : ''; %>
<% const bingoStyle = typeof bingoMusicalStyle !== 'undefined' ? (bingoMusicalStyle || '') : ''; %>
<% const onConnaitNotes = typeof onConnaitChansonNotes !== 'undefined' ? (onConnaitChansonNotes || '') : ''; %>
<% const styleOptions = typeof BINGO_MUSICAL_STYLE_OPTIONS !== 'undefined'
  ? BINGO_MUSICAL_STYLE_OPTIONS
  : []; %>

<section class="form-section form-section-service-base" id="services-base">
  <h2 class="form-section-title">Équipements fournis</h2>
  <div class="row g-3">
    <% baseOptions.forEach(function(service, idx) { %>
      <div class="col-12 col-md-6">
        <div class="form-check service-check-item">
          <input class="form-check-input" type="checkbox" name="services" value="<%= service %>"
                 id="svc_base_<%= idx %>"
                 <%= selected.includes(service) ? 'checked' : '' %>>
          <label class="form-check-label" for="svc_base_<%= idx %>"><%= service %></label>
        </div>
      </div>
    <% }); %>
  </div>
</section>

<% if (addonOptions.length > 0) { %>
  <section class="form-section form-section-ajouts" id="ajouts">
    <h2 class="form-section-title">Ajouts</h2>
    <p class="text-muted small mb-3">Équipements et options additionnelles.</p>
    <div class="row g-3">
      <% addonOptions.forEach(function(service, idx) { %>
        <div class="col-12 col-md-6">
          <div class="form-check service-check-item">
            <input class="form-check-input" type="checkbox" name="services" value="<%= service %>"
                   id="svc_addon_<%= idx %>"
                   <%= selected.includes(service) ? 'checked' : '' %>>
            <label class="form-check-label" for="svc_addon_<%= idx %>"><%= service %></label>
          </div>
        </div>
      <% }); %>
    </div>
  </section>
<% } %>

<section class="form-section form-section-supplementary" id="animation">
  <h2 class="form-section-title">Animation</h2>
  <div class="row g-3">
    <div class="col-12">
      <label class="form-label d-block">Animation</label>
      <div class="btn-group btn-group-sm mb-2" role="group" aria-label="Animation incluse">
        <input type="radio" class="btn-check" name="animation_included" id="animation_included_yes" value="yes"
               <%= animationIncluded === 'yes' ? 'checked' : '' %>>
        <label class="btn btn-outline-secondary" for="animation_included_yes">Oui</label>
        <input type="radio" class="btn-check" name="animation_included" id="animation_included_no" value="no"
               <%= animationIncluded === 'no' ? 'checked' : '' %>>
        <label class="btn btn-outline-secondary" for="animation_included_no">Non</label>
        <input type="radio" class="btn-check" name="animation_included" id="animation_included_none" value="none"
               <%= !animationIncluded ? 'checked' : '' %>>
        <label class="btn btn-outline-secondary" for="animation_included_none">Aucun</label>
      </div>
      <label class="form-label" for="animation_notes">Précisions</label>
      <input type="text" class="form-control" name="animation_notes" id="animation_notes"
             value="<%= animationNotes %>"
             placeholder="Type d'animation, jeux, notes…">
    </div>

    <% if (supplementaryOptions.length > 0) { %>
      <% supplementaryOptions.forEach(function(service, idx) { %>
        <% if (service === 'Bingo musical') { %>
          <div class="col-12">
            <div class="row g-2 align-items-end">
              <div class="col-md-6">
                <div class="form-check service-check-item">
                  <input class="form-check-input" type="checkbox" name="services" value="<%= service %>"
                         id="svc_supp_<%= idx %>"
                         <%= selected.includes(service) ? 'checked' : '' %>>
                  <label class="form-check-label" for="svc_supp_<%= idx %>"><%= service %></label>
                </div>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="bingo_musical_style">Style</label>
                <select class="form-select" name="bingo_musical_style" id="bingo_musical_style">
                  <option value="">— Choisir —</option>
                  <% styleOptions.forEach(function(style) { %>
                    <option value="<%= style %>" <%= bingoStyle === style ? 'selected' : '' %>><%= style %></option>
                  <% }); %>
                </select>
              </div>
            </div>
          </div>
        <% } else if (service === 'On connaît la chanson') { %>
          <div class="col-12">
            <div class="row g-2 align-items-end">
              <div class="col-md-6">
                <div class="form-check service-check-item">
                  <input class="form-check-input" type="checkbox" name="services" value="<%= service %>"
                         id="svc_supp_<%= idx %>"
                         <%= selected.includes(service) ? 'checked' : '' %>>
                  <label class="form-check-label" for="svc_supp_<%= idx %>"><%= service %></label>
                </div>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="on_connait_chanson_notes">Précisions</label>
                <input type="text" class="form-control" name="on_connait_chanson_notes" id="on_connait_chanson_notes"
                       value="<%= onConnaitNotes %>"
                       placeholder="Thème, époque, notes…">
              </div>
            </div>
          </div>
        <% } else { %>
          <div class="col-12 col-md-6">
            <div class="form-check service-check-item">
              <input class="form-check-input" type="checkbox" name="services" value="<%= service %>"
                     id="svc_supp_<%= idx %>"
                     <%= selected.includes(service) ? 'checked' : '' %>>
              <label class="form-check-label" for="svc_supp_<%= idx %>"><%= service %></label>
            </div>
          </div>
        <% } %>
      <% }); %>
    <% } %>
  </div>
</section>

<section class="form-section form-section-custom-services" id="services-personnalises">
  <h2 class="form-section-title">Services personnalisés</h2>
  <p class="text-muted small mb-3">Nommez jusqu'à <%= CUSTOM_SERVICE_SLOT_COUNT %> services additionnels — enregistrés dès qu'un nom est saisi.</p>
  <div class="row g-2">
    <% for (let i = 1; i <= CUSTOM_SERVICE_SLOT_COUNT; i++) { %>
      <% const slot = customSlots[i - 1] || { enabled: false, name: '' }; %>
      <div class="col-md-6">
        <div class="input-group input-group-sm">
          <span class="input-group-text px-2">
            <input class="form-check-input mt-0" type="checkbox"
                   name="custom_service_enabled_<%= i %>" value="1"
                   id="custom_svc_<%= i %>"
                   <%= slot.enabled ? 'checked' : '' %>>
          </span>
          <input type="text" class="form-control" name="custom_service_<%= i %>"
                 placeholder="Service <%= i %>"
                 value="<%= slot.name || '' %>"
                 aria-label="Service personnalisé <%= i %>"
                 data-custom-service-input="<%= i %>">
        </div>
      </div>
    <% } %>
  </div>
</section>
