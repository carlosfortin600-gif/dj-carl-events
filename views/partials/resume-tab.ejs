<% if (resumeSaved) { %>
  <div class="alert alert-success">Informations enregistrées.</div>
<% } %>

<div class="row g-4">
  <div class="col-lg-7">
    <form method="post" action="/events/<%= event.id %>/resume/save" data-unsaved-guard>
      <%- include('resume-form-fields', {
        event,
        eventTypes: EVENT_TYPES,
        selectedServices,
        customServiceSlots,
        resumeShowServices: true,
        resumeShowStatus: true,
        resumeShowRouteOrigin: true,
        resumeLockEventSchedule: false
      }) %>

      <button type="submit" class="btn btn-primary btn-lg mt-4">Enregistrer les informations</button>
      <p class="text-muted small mt-2 mb-0">Rien n'est enregistré tant que vous n'appuyez pas sur ce bouton (Entrée ne sauvegarde plus par accident).</p>
    </form>
  </div>

  <div class="col-lg-5">
    <%- include('portal-link', { event, portalLinks, portalRegenerated, portalToggled }) %>

    <h2 class="h5 mb-3">Résumé rapide</h2>
    <ul class="list-group">
      <li class="list-group-item d-flex justify-content-between">
        <span>Questionnaire</span>
        <strong class="<%= summary.questionnaireComplete ? 'text-success' : 'text-warning' %>">
          <%= summary.questionnaireComplete ? 'Complété' : 'Incomplet' %>
        </strong>
      </li>
      <li class="list-group-item d-flex justify-content-between">
        <span>Plan de soirée</span>
        <strong><%= summary.timelineCount %> étape<%= summary.timelineCount !== 1 ? 's' : '' %></strong>
      </li>
      <% if (isWeddingEvent(event.event_type)) { %>
      <li class="list-group-item d-flex justify-content-between">
        <span>Première danse</span>
        <strong class="<%= summary.firstDanceDefined ? 'text-success' : 'text-muted' %>">
          <%= summary.firstDanceDefined ? 'Définie' : 'Non définie' %>
        </strong>
      </li>
      <% } %>
      <li class="list-group-item d-flex justify-content-between">
        <span>Musique reçue</span>
        <strong class="<%= summary.musicReceived ? 'text-success' : 'text-muted' %>">
          <%= summary.musicReceived ? 'Oui' : 'Non' %>
        </strong>
      </li>
    </ul>
  </div>
</div>
