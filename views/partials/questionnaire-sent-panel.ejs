<% const logs = typeof questionnaireSentLogs !== 'undefined' ? questionnaireSentLogs : []; %>
<% const compact = typeof compactPanel !== 'undefined' && compactPanel; %>
<% const showAddForm = typeof showAddForm === 'undefined' ? true : showAddForm; %>
<% const returnPath = typeof returnTo !== 'undefined' ? returnTo : '/'; %>
<% const defaultSentDt = typeof defaultSentDatetime !== 'undefined' ? defaultSentDatetime : ''; %>
<% const eventDateValue = typeof eventDate !== 'undefined' ? eventDate : ''; %>

<div class="questionnaire-sent-panel<%= compact ? ' questionnaire-sent-panel--compact' : '' %>" onclick="event.stopPropagation()">
  <div class="questionnaire-sent-panel-label fw-semibold<%= compact ? ' text-muted small' : '' %>">Questionnaire envoyé</div>

  <% if (logs.length) { %>
    <ul class="questionnaire-sent-log-list list-unstyled mb-2<%= compact ? ' small' : '' %>">
      <% logs.forEach(function(log) { %>
        <li class="questionnaire-sent-log-item d-flex flex-wrap align-items-center gap-2<%= compact ? ' mb-1' : ' mb-2' %>">
          <span><%= formatDateTimeFr(log.sent_date, log.sent_time) %></span>
          <form method="post"
                action="/events/<%= eventId %>/questionnaire-sent/<%= log.id %>/delete"
                class="d-inline mb-0"
                onsubmit="return confirm('Supprimer cet envoi ?');">
            <input type="hidden" name="returnTo" value="<%= returnPath %>">
            <button type="submit" class="btn btn-link btn-sm p-0 text-danger">Supprimer</button>
          </form>
        </li>
      <% }); %>
    </ul>
  <% } else { %>
    <p class="text-muted<%= compact ? ' small' : '' %> mb-2">Aucun envoi enregistré.</p>
  <% } %>

  <% if (showAddForm) { %>
    <form method="post"
          action="/events/<%= eventId %>/questionnaire-sent/add"
          class="questionnaire-sent-add-form d-flex flex-wrap align-items-center gap-2<%= compact ? ' small' : '' %>"
          data-questionnaire-sent-add-form>
      <input type="hidden" name="returnTo" value="<%= returnPath %>">
      <span class="text-muted">Ajouter</span>
      <%- include('datetime-fr-field', {
        id: 'questionnaire_sent_add_' + eventId + (compact ? '_compact' : ''),
        name: 'sent_datetime',
        value: defaultSentDt,
        displayValue: defaultSentDt ? formatDateTimeFr(defaultSentDt.slice(0, 10), defaultSentDt.slice(11, 16)) : ''
      }) %>
      <button type="submit" class="btn btn-sm btn-outline-primary">Ajouter</button>
    </form>
  <% } %>
</div>
