<div class="list-group-item upcoming-event-row py-2">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-2">
    <div class="flex-grow-1">
      <div class="upcoming-event-line text-break">
        <strong><%= formatDateFr(ev.event_date) %></strong>
        <span class="text-muted mx-1">|</span>
        <%= clientShortName(ev) %>
        <span class="text-muted mx-1">|</span>
        <%= eventCity(ev) || '—' %>
        <span class="text-muted mx-1">|</span>
        <%= ev.event_type %>
        <span class="text-muted mx-1">|</span>
        <%= ev.thematicSummary || '—' %>
        <span class="text-muted mx-1">|</span>
        <span class="event-row-price fw-semibold"><%= ev.chargedPrice || '—' %></span>
      </div>
      <%- include('questionnaire-sent-panel', {
        eventId: ev.id,
        eventDate: ev.event_date,
        questionnaireSentLogs: ev.questionnaireSentLogs || [],
        returnTo: '/',
        compactPanel: true,
        defaultSentDatetime: defaultQuestionnaireSentDatetime()
      }) %>
    </div>
    <a href="/events/<%= ev.id %>" class="btn btn-outline-primary btn-sm flex-shrink-0">Ouvrir</a>
  </div>
</div>
