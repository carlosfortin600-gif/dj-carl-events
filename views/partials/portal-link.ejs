<div class="card border-primary mb-4">
  <div class="card-header bg-primary text-white py-3">
    <h2 class="h6 mb-0">Lien privé pour cet événement</h2>
  </div>
  <div class="card-body">
    <% if (portalRegenerated) { %>
      <div class="alert alert-warning py-2 small">Nouveau lien généré. L'ancien lien ne fonctionne plus.</div>
    <% } %>
    <% if (portalToggled) { %>
      <div class="alert alert-success py-2 small">Accès client mis à jour.</div>
    <% } %>

    <% if (typeof questionnaireEmailSent !== 'undefined' && questionnaireEmailSent) { %>
      <div class="alert alert-success py-2 small">
        <% if (typeof questionnaireEmailForwarded !== 'undefined' && questionnaireEmailForwarded) { %>
          Courriel envoyé à <strong><%= questionnaireEmailCopyTo || 'pro@djcarl.ca' %></strong> (mode test Resend).
          Transmettez-le au client <strong><%= event.email %></strong>.
        <% } else { %>
          Courriel questionnaire envoyé au client<% if (typeof questionnaireEmailCopyTo !== 'undefined' && questionnaireEmailCopyTo) { %> (copie à <%= questionnaireEmailCopyTo %>)<% } %>.
        <% } %>
        <% const justSent = typeof questionnaireSentLogs !== 'undefined' && questionnaireSentLogs.length ? questionnaireSentLogs[0] : null; %>
        <% if (justSent) { %>
          <span class="d-block mt-1">Date d'envoi : <strong><%= formatSentAt(justSent.sent_date, justSent.sent_time) %></strong></span>
        <% } %>
      </div>
    <% } %>
    <% if (typeof questionnaireEmailError !== 'undefined' && questionnaireEmailError) { %>
      <div class="alert alert-danger py-2 small"><%= questionnaireEmailError %></div>
    <% } %>

    <p class="text-muted small mb-3">
      Ce lien est <strong>unique à cet événement</strong>. Envoyez-le par texto ou courriel —
      votre client pourra remplir le questionnaire sans voir vos autres dossiers.
      <% if (portalLinks.lan) { %>
        Sur le même réseau Wi‑Fi, utilisez le <strong>lien réseau local</strong> pour les téléphones.
      <% } %>
    </p>

    <label class="form-label small fw-semibold">Lien à partager</label>
    <div class="input-group mb-2">
      <input type="text" class="form-control font-monospace small" id="portalLinkPrimary" readonly value="<%= portalLinks.primary %>">
      <button type="button" class="btn btn-outline-primary" data-copy-target="portalLinkPrimary">Copier</button>
    </div>

    <% if (portalLinks.lan) { %>
      <label class="form-label small fw-semibold mt-3">Lien réseau local (téléphones)</label>
      <div class="input-group mb-2">
        <input type="text" class="form-control font-monospace small" id="portalLinkLan" readonly value="<%= portalLinks.lan %>">
        <button type="button" class="btn btn-outline-secondary" data-copy-target="portalLinkLan">Copier</button>
      </div>
    <% } %>

    <div class="d-flex flex-wrap gap-2 mt-3">
      <a href="<%= portalLinks.primary %>" target="_blank" rel="noopener" class="btn btn-sm btn-primary">Ouvrir le portail</a>
      <form method="post" action="/events/<%= event.id %>/portal/regenerate" class="d-inline">
        <button type="submit" class="btn btn-sm btn-outline-warning">Régénérer le lien</button>
      </form>
      <% if (event.portal_enabled) { %>
        <form method="post" action="/events/<%= event.id %>/portal/toggle" class="d-inline">
          <input type="hidden" name="enabled" value="0">
          <button type="submit" class="btn btn-sm btn-outline-danger">Désactiver l'accès</button>
        </form>
      <% } else { %>
        <form method="post" action="/events/<%= event.id %>/portal/toggle" class="d-inline">
          <input type="hidden" name="enabled" value="1">
          <button type="submit" class="btn btn-sm btn-outline-success">Réactiver l'accès</button>
        </form>
      <% } %>
    </div>

    <% if (!event.portal_enabled) { %>
      <div class="alert alert-danger mt-3 mb-0 py-2 small">L'accès client est actuellement <strong>désactivé</strong>.</div>
    <% } else if (event.portal_last_accessed) { %>
      <p class="text-muted small mt-3 mb-0">Dernier accès client : <%= event.portal_last_accessed %></p>
    <% } %>
    <% if (typeof lastPortalClientUpdate !== 'undefined' && lastPortalClientUpdate) { %>
      <p class="text-muted small mt-2 mb-0">
        Dernière modification enregistrée :
        <strong><%= lastPortalClientUpdate.kindLabel %></strong>
        — <%= formatTimestampFr(lastPortalClientUpdate.created_at) %>
      </p>
    <% } %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header bg-white py-3">
    <h2 class="h6 mb-0">Courriel — questionnaire et rendez-vous</h2>
  </div>
  <div class="card-body">
    <p class="text-muted small mb-3">
      Envoie au client le <strong>lien du questionnaire</strong> avec un message lui demandant de remplir le formulaire
      au mieux de sa connaissance, puis de <strong>prendre rendez-vous avec vous</strong> une fois complété.
      <% if (typeof questionnaireEmailCopyTo !== 'undefined' && questionnaireEmailCopyTo) { %>
        Copie automatique à <strong><%= questionnaireEmailCopyTo %></strong>.
      <% } %>
    </p>

    <% const lastQuestionnaireEmail = typeof questionnaireSentLogs !== 'undefined' && questionnaireSentLogs.length ? questionnaireSentLogs[0] : null; %>
    <% if (lastQuestionnaireEmail) { %>
      <p class="small mb-3">
        Dernier courriel questionnaire :
        <strong><%= formatSentAt(lastQuestionnaireEmail.sent_date, lastQuestionnaireEmail.sent_time) %></strong>
      </p>
    <% } %>

    <% if (typeof questionnaireEmailPreview !== 'undefined' && questionnaireEmailPreview) { %>
      <details class="mb-3">
        <summary class="small fw-semibold mb-2" style="cursor:pointer;">Aperçu du courriel</summary>
        <div class="border rounded p-3 bg-light small">
          <p class="text-center mb-3"><img src="/img/logo-dj-carl.png" alt="DJ Carl" width="96" height="96" style="border-radius:50%;"></p>
          <p class="mb-2"><strong>Objet :</strong> <%= questionnaireEmailPreview.subject %></p>
          <pre class="mb-0 small" style="white-space:pre-wrap;font-family:inherit;"><%= questionnaireEmailPreview.text %></pre>
        </div>
      </details>
    <% } %>

    <% if (!event.email?.trim()) { %>
      <div class="alert alert-warning py-2 small mb-0">Ajoutez le courriel du client dans l'onglet Résumé avant d'envoyer.</div>
    <% } else if (typeof emailNotificationConfigured !== 'undefined' && !emailNotificationConfigured) { %>
      <div class="alert alert-warning py-2 small mb-0">
        Courriel non configuré.
        <a href="/settings/notifications">Paramètres → Notifications</a>
      </div>
    <% } else if (!event.portal_enabled) { %>
      <div class="alert alert-warning py-2 small mb-0">Réactivez l'accès client avant d'envoyer le courriel.</div>
    <% } else { %>
      <form method="post" action="/events/<%= event.id %>/questionnaire-email/send" class="mb-0">
        <button type="submit" class="btn btn-primary">
          Envoyer le courriel questionnaire
        </button>
      </form>
      <p class="text-muted small mt-2 mb-0">Destinataire : <%= event.email %></p>
    <% } %>
  </div>
</div>

<div class="card mb-4 border-success">
  <div class="card-header bg-white py-3">
    <h2 class="h6 mb-0">Confirmation du questionnaire par le client</h2>
  </div>
  <div class="card-body">
    <% if (typeof clientUnconfirmed !== 'undefined' && clientUnconfirmed) { %>
      <div class="alert alert-success py-2 small">Confirmation réinitialisée — le client peut de nouveau modifier son dossier en ligne.</div>
    <% } %>
    <% if (typeof confirmationEmailSent !== 'undefined' && confirmationEmailSent) { %>
      <div class="alert alert-success py-2 small">
        <% if (typeof confirmationEmailForwarded !== 'undefined' && confirmationEmailForwarded) { %>
          Courriel de confirmation envoyé à <strong><%= confirmationEmailCopyTo || 'pro@djcarl.ca' %></strong> (mode test Resend).
          Transmettez-le au client <strong><%= event.email %></strong>.
        <% } else { %>
          Courriel de confirmation envoyé au client<% if (typeof confirmationEmailCopyTo !== 'undefined' && confirmationEmailCopyTo) { %> (copie à <%= confirmationEmailCopyTo %>)<% } %>.
        <% } %>
      </div>
    <% } %>
    <% if (typeof confirmationEmailError !== 'undefined' && confirmationEmailError) { %>
      <div class="alert alert-danger py-2 small"><%= confirmationEmailError %></div>
    <% } %>

    <% if (event.client_confirmed_at) { %>
      <div class="alert alert-success py-2 mb-3">
        <strong>Dossier confirmé</strong>
        <% if (event.client_confirmed_by_name) { %> par <%= event.client_confirmed_by_name %><% } %>
        le <%= formatTimestampFr(event.client_confirmed_at) %>.
        L'accès client en ligne est verrouillé.
      </div>
      <form method="post" action="/events/<%= event.id %>/client/unconfirm" class="mb-0"
            onsubmit="return confirm('Réouvrir le dossier pour le client ? Il pourra modifier le questionnaire à nouveau.');">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Réouvrir le dossier client</button>
      </form>
    <% } else { %>
      <p class="text-muted small mb-3">
        Une fois le questionnaire rempli, envoyez ce courriel : le client vérifie que tout est correct et confirme en un clic
        (lien <strong>/confirmer</strong>). Envoi automatique aussi <strong><%= typeof confirmationDaysBefore !== 'undefined' ? confirmationDaysBefore : 6 %> jours</strong> avant la date de l'événement.
      </p>

      <% if (event.confirmation_email_sent_at) { %>
        <p class="small mb-2">
          Dernier courriel de confirmation :
          <strong><%= formatTimestampFr(event.confirmation_email_sent_at) %></strong>
        </p>
      <% } %>

      <% if (typeof clientConfirmUrl !== 'undefined' && clientConfirmUrl && event.confirmation_email_sent_at) { %>
        <label class="form-label small fw-semibold">Lien de confirmation (client)</label>
        <div class="input-group mb-3">
          <input type="text" class="form-control font-monospace small" id="clientConfirmLink" readonly value="<%= clientConfirmUrl %>">
          <button type="button" class="btn btn-outline-primary" data-copy-target="clientConfirmLink">Copier</button>
        </div>
      <% } else if (event.portal_enabled) { %>
        <div class="alert alert-warning py-2 small mb-3">
          Le lien de confirmation sera actif après l'envoi du courriel de confirmation (ou l'envoi automatique <%= typeof confirmationDaysBefore !== 'undefined' ? confirmationDaysBefore : 6 %> jours avant).
        </div>
      <% } %>

      <% if (typeof confirmationEmailPreview !== 'undefined' && confirmationEmailPreview) { %>
        <details class="mb-3">
          <summary class="small fw-semibold mb-2" style="cursor:pointer;">Aperçu du courriel de confirmation</summary>
          <div class="border rounded p-3 bg-light small">
            <p class="mb-2"><strong>Objet :</strong> <%= confirmationEmailPreview.subject %></p>
            <pre class="mb-0 small" style="white-space:pre-wrap;font-family:inherit;"><%= confirmationEmailPreview.text %></pre>
          </div>
        </details>
      <% } %>

      <% if (!event.email?.trim()) { %>
        <div class="alert alert-warning py-2 small mb-0">Ajoutez le courriel du client dans l'onglet Résumé avant d'envoyer.</div>
      <% } else if (typeof emailNotificationConfigured !== 'undefined' && !emailNotificationConfigured) { %>
        <div class="alert alert-warning py-2 small mb-0">
          Courriel non configuré.
          <a href="/settings/notifications">Paramètres → Notifications</a>
        </div>
      <% } else if (!event.portal_enabled) { %>
        <div class="alert alert-warning py-2 small mb-0">Réactivez l'accès client avant d'envoyer le courriel de confirmation.</div>
      <% } else { %>
        <form method="post" action="/events/<%= event.id %>/confirmation-email/send" class="mb-0" data-native-submit="true">
          <button type="submit" class="btn btn-success">
            Envoyer le courriel de confirmation
          </button>
        </form>
        <p class="text-muted small mt-2 mb-0">Destinataire : <%= event.email %></p>
      <% } %>
    <% } %>
  </div>
</div>
