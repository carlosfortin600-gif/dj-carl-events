<%#
  song: { artist, title, spotify_url, confirmed }
  prefix: form field prefix e.g. first_dance, entrance_procession
%>
<div class="row g-2 align-items-end">
  <div class="col-md-4 col-lg-3">
    <label class="form-label small mb-1">Artiste</label>
    <input type="text" class="form-control" name="<%= prefix %>_artist" placeholder="Artiste"
           value="<%= song.artist || '' %>">
  </div>
  <div class="col-md-4 col-lg-3">
    <label class="form-label small mb-1">Chanson</label>
    <input type="text" class="form-control" name="<%= prefix %>_title" placeholder="Chanson"
           value="<%= song.title || '' %>">
  </div>
  <div class="col-md-4 col-lg-4">
    <label class="form-label small mb-1">Lien Spotify</label>
    <input type="url" class="form-control" name="<%= prefix %>_spotify"
           placeholder="https://open.spotify.com/track/…"
           value="<%= song.spotify_url || '' %>">
  </div>
  <div class="col-md-12 col-lg-2">
    <div class="form-check song-confirmed-check mb-2">
      <input class="form-check-input" type="checkbox" name="<%= prefix %>_confirmed" value="1"
             id="<%= prefix %>_confirmed"
             <%= song.confirmed ? 'checked' : '' %>>
      <label class="form-check-label" for="<%= prefix %>_confirmed">Chanson validée</label>
    </div>
  </div>
</div>
<% if (song.spotify_url) { %>
  <p class="small mb-0 mt-1">
    <a href="<%= song.spotify_url %>" target="_blank" rel="noopener noreferrer">Ouvrir sur Spotify ↗</a>
  </p>
<% } %>
