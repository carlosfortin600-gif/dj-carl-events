<% function gestionContratUrl(id) { return '/events/' + id + '?tab=gestion&gestion=contrat'; } %>

<section class="logistique-section logistique-section-employees mt-3 pt-3 border-top">
  <span class="badge bg-light text-dark border mb-2">Employés — contrat</span>
  <% if (!ev.employeeLines || !ev.employeeLines.length) { %>
    <p class="text-muted small mb-0">
      Aucun contrat enregistré.
      <a href="<%= gestionContratUrl(ev.id) %>">Gestion → Contrat</a>
    </p>
  <% } else { %>
    <form method="post" action="/events/<%= ev.id %>/logistique-employees/save" class="logistique-employees-form">
      <input type="hidden" name="returnTo" value="/logistique">
      <div class="logistique-employees-list">
        <% ev.employeeLines.forEach(function(emp) { %>
          <% const sid = emp.subcontractorId; %>
          <% const rowKey = 'ev' + ev.id + '_' + sid; %>
          <% const withMeYesId = rowKey + '_with_yes'; %>
          <% const withMeNoId = rowKey + '_with_no'; %>
          <div class="logistique-employee-row d-flex flex-wrap align-items-end gap-2 gap-lg-3 small mb-3 pb-3 border-bottom border-light">
            <div class="logistique-emp-field logistique-emp-field-name">
              <span class="text-muted d-block">Employé</span>
              <span class="fw-semibold"><%= emp.label %></span>
            </div>
            <div class="logistique-emp-field logistique-emp-field-with-me">
              <span class="text-muted d-block mb-1">Déjà avec moi</span>
              <div class="btn-group btn-group-sm logistique-emp-with-me" role="group" aria-label="Déjà avec moi — <%= emp.label %>">
                <input type="radio" class="btn-check" name="emp_<%= sid %>_with_me" id="<%= withMeYesId %>" value="yes"
                       <%= emp.withMe === 'yes' ? 'checked' : '' %>>
                <label class="btn btn-outline-primary fw-semibold" for="<%= withMeYesId %>">Oui</label>
                <input type="radio" class="btn-check" name="emp_<%= sid %>_with_me" id="<%= withMeNoId %>" value="no"
                       <%= emp.withMe === 'no' ? 'checked' : '' %>>
                <label class="btn btn-outline-primary fw-semibold" for="<%= withMeNoId %>">Non</label>
              </div>
            </div>
            <div class="logistique-emp-field logistique-emp-field-arrival logistique-emp-when-target">
              <label class="form-label mb-0 text-muted" for="<%= rowKey %>_arrival">Arrivée</label>
              <input type="time" class="form-control form-control-sm logistique-emp-when-field" id="<%= rowKey %>_arrival"
                     name="emp_<%= sid %>_arrival_time" value="<%= emp.arrivalTime %>" step="300"
                     <%= emp.withMe === 'yes' ? 'disabled' : '' %>>
            </div>
            <div class="logistique-emp-field logistique-emp-field-location logistique-emp-when-target">
              <label class="form-label mb-0 text-muted" for="<%= rowKey %>_location">Endroit</label>
              <select class="form-select form-select-sm logistique-emp-location logistique-emp-when-field"
                      id="<%= rowKey %>_location" name="emp_<%= sid %>_location"
                      data-custom-target="<%= rowKey %>_custom_wrap"
                      <%= emp.withMe === 'yes' ? 'disabled' : '' %>>
                <% emp.locationChoices.forEach(function(choice) { %>
                  <option value="<%= choice.key %>"<%= emp.locationKey === choice.key ? ' selected' : '' %>>
                    <%= choice.label %><% if (choice.address) { %> — <%= choice.address.length > 40 ? choice.address.slice(0, 37) + '…' : choice.address %><% } %>
                  </option>
                <% }); %>
              </select>
            </div>
            <div class="logistique-emp-field logistique-emp-field-custom logistique-emp-custom-wrap logistique-emp-when-target<%= emp.locationKey === 'other' ? '' : ' d-none' %>"
                 id="<%= rowKey %>_custom_wrap">
              <label class="form-label mb-0 text-muted" for="<%= rowKey %>_custom">Précision</label>
              <input type="text" class="form-control form-control-sm logistique-emp-when-field" id="<%= rowKey %>_custom"
                     name="emp_<%= sid %>_location_custom" value="<%= emp.locationCustom %>"
                     placeholder="Adresse ou lieu"
                     <%= emp.withMe === 'yes' ? 'disabled' : '' %>>
            </div>
          </div>
        <% }); %>
      </div>
      <button type="submit" class="btn btn-sm btn-primary">Enregistrer employés</button>
    </form>
  <% } %>
</section>