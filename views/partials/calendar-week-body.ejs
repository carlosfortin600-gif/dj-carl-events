<% function dayUrl(dateStr) {
  const q = queryString({ view: 'day', date: dateStr });
  return calendarBasePath + '?' + q;
} %>

<div class="calendar-week-grid">
  <% weekDays.forEach(function(day) { %>
    <div class="calendar-week-col <%= day.events.length ? 'has-events' : '' %> <%= day.isToday ? 'is-today' : '' %>">
      <a href="<%= dayUrl(day.iso) %>" class="calendar-week-col-head text-decoration-none">
        <span class="calendar-week-col-weekday"><%= day.weekdayLabel %></span>
        <span class="calendar-week-col-day"><%= day.dayNum %></span>
      </a>
      <div class="calendar-week-col-events">
        <% if (!day.events.length) { %>
          <span class="text-muted small">—</span>
        <% } else { %>
          <% day.events.forEach(function(ev) { %>
            <div class="calendar-week-event calendar-event-card status-border-<%= ev.status %>">
              <div class="calendar-week-event-title"><%= clientShortName(ev) %></div>
              <div class="calendar-week-event-meta small text-muted">
                <% if (ev.calendarTime || ev.start_time) { %><%= formatTime(ev.calendarTime || ev.start_time) %> · <% } %><%= ev.event_type %>
              </div>
              <%- include('calendar-agreement-summary', { ev, showAgreementSummary: typeof showAgreementSummary !== 'undefined' ? showAgreementSummary : false }) %>
              <%- include('calendar-contract-btn', {
                ev,
                subcontractorLabel: typeof subcontractorLabel !== 'undefined' ? subcontractorLabel : '',
                showContractLink: typeof showContractLink !== 'undefined' ? showContractLink : false,
                showAgreementSummary: typeof showAgreementSummary !== 'undefined' ? showAgreementSummary : false,
                publicCalendarMode: typeof publicCalendarMode !== 'undefined' ? publicCalendarMode : false,
                compact: true
              }) %>
            </div>
          <% }); %>
        <% } %>
      </div>
      <% if (showDayGestionDetails && day.gestionDetails) { %>
        <div class="calendar-week-col-gestion">
          <%- include('calendar-gestion-blocks', { gestionDetails: day.gestionDetails, compact: true }) %>
        </div>
      <% } %>
    </div>
  <% }); %>
</div>
