<% if (typeof showAgreementSummary !== 'undefined' && showAgreementSummary) { %>
  <div class="calendar-agreement-summary mt-2">
    <div class="small fw-semibold text-uppercase text-muted mb-1" style="font-size: 0.65rem; letter-spacing: 0.03em;">Entente</div>
    <% if (ev.hasAgreement && ev.agreementSummary) { %>
      <p class="small mb-1 calendar-agreement-summary-text"><%= ev.agreementSummary %></p>
      <% if (ev.agreementSigned) { %>
        <span class="badge text-bg-success">Signé</span>
      <% } else { %>
        <span class="badge text-bg-warning">Signatures en attente</span>
      <% } %>
    <% } else { %>
      <p class="small text-muted mb-0">Aucune entente enregistrée</p>
    <% } %>
  </div>
<% } %>
