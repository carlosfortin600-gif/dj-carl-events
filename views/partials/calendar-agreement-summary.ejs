<%- include('calendar-contract-status-summary', { ev }) %>

<% if (typeof showAgreementSummary !== 'undefined' && showAgreementSummary && ev.hasAgreement && ev.agreementSummary) { %>
  <div class="calendar-agreement-summary mt-1">
    <div class="small fw-semibold text-uppercase text-muted mb-1" style="font-size: 0.65rem; letter-spacing: 0.03em;">Détails entente</div>
    <p class="small mb-0 calendar-agreement-summary-text"><%= ev.agreementSummary %></p>
  </div>
<% } %>
